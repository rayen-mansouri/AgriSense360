<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>(function(){var t=localStorage.getItem('agri-theme')||'dark';document.documentElement.setAttribute('data-theme',t);})();</script>
    <title>{% block title %}AgriSense 360{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('css/expert_design.css') }}">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--pg);
            color: var(--pc);
            transition: background 0.3s ease;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif;
        }

        /* PREMIUM NAVBAR */
        .navbar {
            width: 100%;
            padding: 20px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--cb);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--cbr);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-family: 'Outfit', sans-serif;
            font-weight: 900;
            font-size: 1.8rem;
            color: var(--g);
            letter-spacing: -1px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-actions {
            display: flex;
            gap: 16px;
        }

        .btn-main {
            padding: 12px 28px;
            background: linear-gradient(135deg, var(--g), var(--gm));
            color: white;
            border-radius: 14px;
            text-decoration: none;
            font-weight: 700;
            box-shadow: 0 10px 20px rgba(45, 106, 79, 0.2);
            transition: all 0.3s;
        }

        .btn-main:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(45, 106, 79, 0.3);
        }

        .btn-outline {
            padding: 12px 28px;
            border: 1.5px solid var(--cbr);
            border-radius: 14px;
            text-decoration: none;
            color: var(--ch3);
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline:hover {
            background: var(--pg);
            border-color: var(--g);
        }

    </style>

    {% block styles %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>

{% block navbar %}
{% if not app.user %}
<!-- NAVBAR -->
<div class="navbar">
    <div class="logo"><span>🌿</span> AgriSense<span style="opacity:0.6">360</span></div>

    <div class="nav-actions">
        <a href="{{ path('app_login') }}" class="btn-outline">Se connecter</a>
        <a href="{{ path('app_register') }}" class="btn-main">Commencer gratuitement</a>
    </div>
</div>
{% endif %}
{% endblock %}

{% block body %}{% endblock %}

{% block javascripts %}{% endblock %}
</body>
</html>