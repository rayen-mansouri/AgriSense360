{% extends 'base.html.twig' %}

{% set activePage = 'analytics' %}
{% set activeSection = 'main' %}

{% block title %}Analytique IA — Rendements — AgriSense 360{% endblock %}

{% block navbar %}{% endblock %}

{% block styles %}
{% include 'partials/sidebar_styles.html.twig' %}
<style>
    /* Analytics specific refinements */
    :root {
        --kpi-green: #10b981;
        --kpi-blue: #3b82f6;
        --kpi-amber: #f59e0b;
        --kpi-teal: #14b8a6;
    }
    /* Page header refinement */
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 20px; }
    .page-header-left { display: flex; flex-direction: column; gap: 8px; }
    .page-title { font-size: 2.2rem; font-weight: 900; color: var(--ch3); margin: 0; letter-spacing: -1px; }
    .page-subtitle { color: var(--cp); font-size: 1rem; font-weight: 500; }
    .page-breadcrumb { color: var(--cp); font-size: 0.9rem; margin-bottom: 5px; font-weight: 600; }
    .page-breadcrumb a { color: var(--g); text-decoration: none; }
    .page-breadcrumb a:hover { text-decoration: underline; }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 12px; border: 1px solid transparent; font-family: inherit; font-size: 0.95rem; font-weight: 700; cursor: pointer; transition: all 0.2s; text-decoration: none; }
    .btn:active { transform: scale(0.97); }
    .btn-secondary { background: var(--cb); color: var(--cp); border: 1px solid var(--cbr); }
    .btn-secondary:hover { background: rgba(90,181,90,0.05); border-color: var(--g); color: var(--g); }

    /* KPI Cards Refinement */
    .analytics-kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; margin-bottom: 48px; }
    .analytics-kpi-card { 
        background: var(--cb); border: 1.5px solid var(--cbr); border-radius: 28px; padding: 28px; 
        box-shadow: var(--sh-lg); display: flex; flex-direction: column; gap: 12px; 
        position: relative; overflow: hidden; transition: transform 0.3s ease;
    }
    .analytics-kpi-card:hover { transform: translateY(-5px); }
    .analytics-kpi-card::after {
        content: ''; position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; 
        border-radius: 50%; opacity: 0.1; filter: blur(20px);
    }
    .kpi-green::after { background: #10b981; }
    .kpi-blue::after  { background: #3b82f6; }
    .kpi-amber::after { background: #f59e0b; }
    .kpi-teal::after  { background: #14b8a6; }
    
    .kpi-icon { font-size: 2.2rem; margin-bottom: 5px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1)); }
    .kpi-value { font-size: 2rem; font-weight: 900; color: var(--ch3); line-height: 1; font-family: 'Inter', sans-serif; }
    .kpi-label { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--cp); letter-spacing: 1px; }

    /* Analytics Cards */
    .analytics-card { 
        background: var(--cb); border: 1.5px solid var(--cbr); border-radius: 32px; 
        box-shadow: var(--sh-lg); overflow: hidden; margin-bottom: 40px; 
        backdrop-filter: blur(10px);
    }
    .analytics-card-header { 
        padding: 28px 35px; border-bottom: 1.5px solid var(--cbr); 
        background: rgba(255,255,255,0.02); display: flex; align-items: center; justify-content: space-between;
    }
    .analytics-card-title { margin: 0; font-size: 1.3rem; font-weight: 900; color: var(--ch3); display: flex; align-items: center; gap: 15px; }

    /* Tables */
    .analytics-table-wrap { overflow-x: auto; padding: 10px; }
    .analytics-table { width: 100%; border-collapse: separate; border-spacing: 0; }
    .analytics-table th { 
        padding: 20px 25px; text-align: left; font-size: 0.7rem; font-weight: 900; 
        text-transform: uppercase; letter-spacing: 1.5px; color: var(--cp); 
        border-bottom: 1.5px solid var(--cbr); background: rgba(0,0,0,0.1);
    }
    .analytics-table td { padding: 20px 25px; border-bottom: 1.2px solid var(--cbr); color: var(--ch3); font-weight: 600; font-size: 0.95rem; }
    .analytics-table tr:last-child td { border-bottom: none; }
    .analytics-table tbody tr:hover td { background: rgba(90,181,90,0.05); }
    
    .rendement-badge {
        display: inline-block; padding: 6px 14px; background: rgba(16,185,129,0.15); 
        border-radius: 12px; color: #10b981; font-weight: 800; border: 1px solid rgba(16,185,129,0.2);
    }

    .empty-state { padding: 100px 40px; text-align: center; background: var(--cb); border-radius: 40px; border: 2px dashed var(--cbr); }
    .empty-icon { font-size: 4rem; margin-bottom: 20px; }
    .empty-title { font-size: 1.8rem; font-weight: 900; color: var(--ch3); margin-bottom: 10px; }
    .empty-subtitle { color: var(--cp); font-size: 1.1rem; max-width: 500px; margin: 0 auto; line-height: 1.6; }
</style>
{% endblock %}

{% block body %}
<div class="layout">
    {% include 'partials/sidebar.html.twig' %}
    <main class="main" id="mainContent">
        <header class="topbar">
            <button class="sidebar-toggle" id="sidebarToggle">
                <span></span><span></span><span></span>
            </button>
            <div style="display: flex; gap: 16px; align-items: center;">
                <button class="theme-toggle" id="themeToggle">
                    <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
                    <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
                </button>
            </div>
        </header>
        <div class="content-wrapper">

{# ═══════════════════════════════════════════════════
   PAGE HEADER
   ═══════════════════════════════════════════════════ #}
<div class="page-header">
    <div class="page-header-left">
        <p class="page-breadcrumb">
            <a href="{{ path('app_home') }}">🏠 Accueil</a> /
            <a href="{{ path('culture_index') }}">Cultures</a> /
            Analytique IA
        </p>
        <h1 class="page-title">🤖 Analytique IA — Rendements</h1>
        <p class="page-subtitle">Analyse des {{ harvests|length }} récolte(s) enregistrée(s) par le modèle IA</p>
    </div>
    <div>
        <a href="{{ path('culture_index') }}" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Retour aux cultures</a>
    </div>
</div>

{# ── Compute totals in twig ── #}
{% set totalKg   = 0 %}
{% set totalSurf = 0 %}
{% set byNom     = {} %}

{% for h in harvests %}
    {% set totalKg   = totalKg   + (h.quantiteRecolte ?? 0) %}
    {% set totalSurf = totalSurf + (h.surface ?? 0) %}
    {% set nom = h.cultureNom ?? 'Inconnu' %}
    {% if byNom[nom] is not defined %}
        {% set byNom = byNom|merge({(nom): {qty: 0, count: 0, surface: 0}}) %}
    {% endif %}
    {% set byNom = byNom|merge({(nom): {
        qty:     byNom[nom].qty     + (h.quantiteRecolte ?? 0),
        count:   byNom[nom].count   + 1,
        surface: byNom[nom].surface + (h.surface ?? 0)
    }}) %}
{% endfor %}

{% if harvests is empty %}
<div class="empty-state">
    <div class="empty-icon">🤖</div>
    <div class="empty-title">Aucune récolte IA enregistrée</div>
    <div class="empty-subtitle">
        Utilisez le bouton 🌾 Récolter sur les cartes culture pour commencer à collecter des données.
    </div>
</div>
{% else %}

<div class="analytics-kpi-grid">
    <div class="analytics-kpi-card kpi-green">
        <div class="kpi-icon">🌾</div>
        <div class="kpi-value">{{ totalKg|number_format(1,',',' ') }} kg</div>
        <div class="kpi-label">Production totale</div>
    </div>
    <div class="analytics-kpi-card kpi-blue">
        <div class="kpi-icon">📊</div>
        <div class="kpi-value">{{ harvests|length }}</div>
        <div class="kpi-label">Récoltes IA</div>
    </div>
    <div class="analytics-kpi-card kpi-amber">
        <div class="kpi-icon">📐</div>
        <div class="kpi-value">{{ totalSurf|number_format(0,',',' ') }} m²</div>
        <div class="kpi-label">Surface totale</div>
    </div>
    <div class="analytics-kpi-card kpi-teal">
        <div class="kpi-icon">⚡</div>
        <div class="kpi-value">
            {{ totalSurf > 0 ? (totalKg / totalSurf)|number_format(2,',',' ') : '—' }} <span style="font-size:1rem;opacity:0.6;">kg/m²</span>
        </div>
        <div class="kpi-label">Rendement moyen</div>
    </div>
</div>

<div class="analytics-card">
    <div class="analytics-card-header">
        <h3 class="analytics-card-title">📈 Production & Rendement par culture</h3>
    </div>
    <div style="padding:30px;">
        <canvas id="yieldChart" height="100"></canvas>
    </div>
</div>

<div class="analytics-card">
    <div class="analytics-card-header">
        <h3 class="analytics-card-title">🌱 Détail par type de culture</h3>
    </div>
    <div style="overflow-x:auto;">
        <table class="analytics-table">
            <thead>
                <tr>
                    <th>Culture</th>
                    <th>Récoltes</th>
                    <th>Qté (kg)</th>
                    <th>Surface (m²)</th>
                    <th>Rendement (kg/m²)</th>
                </tr>
            </thead>
            <tbody>
                {% for nom, data in byNom %}
                <tr>
                    <td style="color:var(--g);"><strong>{{ nom }}</strong></td>
                    <td>{{ data.count }}</td>
                    <td style="font-weight:800;">{{ data.qty|number_format(1,',',' ') }}</td>
                    <td>{{ data.surface|number_format(1,',',' ') }}</td>
                    <td>
                        {% if data.surface > 0 %}
                            <span style="padding:4px 10px; background:rgba(90,181,90,0.1); border-radius:8px; color:var(--g);">
                                {{ (data.qty / data.surface)|number_format(3,',',' ') }}
                            </span>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr style="background: rgba(0,0,0,0.1); font-weight:800;">
                    <td>Total</td>
                    <td>{{ harvests|length }}</td>
                    <td>{{ totalKg|number_format(1,',',' ') }}</td>
                    <td>{{ totalSurf|number_format(1,',',' ') }}</td>
                    <td>{{ totalSurf > 0 ? (totalKg / totalSurf)|number_format(3,',',' ') : '—' }}</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="analytics-card">
    <div class="analytics-card-header">
        <h3 class="analytics-card-title">🕐 Journal des récoltes</h3>
    </div>
    <div style="overflow-x:auto;">
        <table class="analytics-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Culture</th>
                    <th>Type</th>
                    <th>Quantité IA</th>
                    <th>Surface</th>
                    <th>Analyse IA</th>
                </tr>
            </thead>
            <tbody>
                {% for h in harvests %}
                <tr>
                    <td>{{ h.dateAction|date('d/m/Y') }}</td>
                    <td><strong style="color:var(--g)">{{ h.cultureNom ?? '—' }}</strong></td>
                    <td style="font-size:0.8rem;text-transform:uppercase;font-weight:800;opacity:0.7;">{{ h.typeCulture ?? '—' }}</td>
                    <td style="font-weight:800;">{{ h.quantiteRecolte|number_format(1,',',' ') }} kg</td>
                    <td>{{ h.surface|number_format(0,',',' ') }} m²</td>
                    <td style="font-size:0.85rem; color:var(--cp); max-width:300px; line-height:1.4;">
                        {{ h.description ?? '—' }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endif %}

        </div>
    </main>
</div>

{% if harvests is not empty %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    (function() {
        const byNom = {{ byNom|json_encode|raw }};
        const labels = Object.keys(byNom);
        const qtys   = labels.map(n => byNom[n].qty);
        const yields = labels.map(n => byNom[n].surface > 0 ? byNom[n].qty / byNom[n].surface : 0);

        const ctx = document.getElementById('yieldChart');
        if (!ctx) return;

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const textColor = isDark ? '#a0a0a0' : '#666';

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    {
                        label: 'Production (kg)',
                        data: qtys,
                        backgroundColor: 'rgba(90, 181, 90, 0.6)',
                        borderColor: '#5ab55a',
                        borderWidth: 2,
                        borderRadius: 8,
                        yAxisID: 'y',
                    },
                    {
                        label: 'Rendement (kg/m²)',
                        data: yields,
                        type: 'line',
                        borderColor: '#ffa502',
                        backgroundColor: 'rgba(255, 165, 2, 0.1)',
                        borderWidth: 3,
                        pointRadius: 5,
                        pointBackgroundColor: '#ffa502',
                        tension: 0.4,
                        yAxisID: 'y2',
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { labels: { color: textColor, font: { weight: 'bold' } } }
                },
                scales: {
                    y: {
                        position: 'left',
                        title: { display: true, text: 'kg', color: textColor },
                        ticks: { color: textColor },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    },
                    y2: {
                        position: 'right',
                        title: { display: true, text: 'kg/m²', color: textColor },
                        ticks: { color: textColor },
                        grid: { display: false }
                    },
                    x: {
                        ticks: { color: textColor },
                        grid: { display: false }
                    }
                }
            }
        });
    })();

    // Theme toggle
    const html = document.documentElement;
    const themeBtn = document.getElementById('themeToggleNav');
    if (themeBtn) {
        themeBtn.addEventListener('click', () => {
            const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('agri-theme', next);
        });
    }
</script>
{% endif %}
{% endblock %}
