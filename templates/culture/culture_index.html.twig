{% block javascripts %}
<script>
    /* Sidebar toggle */
    document.getElementById('sidebarToggle')?.addEventListener('click', () => {
        document.getElementById('sidebar').classList.toggle('collapsed');
        document.querySelector('.main').classList.toggle('expanded');
    });

// ═══════════════════════════════════════
// CULTURE MAP
// ═══════════════════════════════════════
const CULTURE_MAP = {{ cultureMap|json_encode|raw }};

// ═══════════════════════════════════════
// VALIDATION HELPERS
// ═══════════════════════════════════════
function setError(inputEl, errEl, msg) { errEl.textContent = msg; inputEl.classList.add('is-invalid'); }
function clearError(inputEl, errEl)    { errEl.textContent = '';  inputEl.classList.remove('is-invalid'); }

function validateCultureForm(prefix) {
    let valid = true;
    const fields = [
        [prefix+'-type',            prefix+'-type-err',            '⚠️ Veuillez sélectionner un type de culture'],
        [prefix+'-nom',             prefix+'-nom-err',             '⚠️ Veuillez sélectionner une culture'],
        [prefix+'-parcelle',        prefix+'-parcelle-err',        '⚠️ Veuillez sélectionner une parcelle'],
        [prefix+'-date-plantation', prefix+'-date-plantation-err', '⚠️ La date de plantation est obligatoire'],
    ];
    fields.forEach(([id, errId, msg]) => {
        const el = document.getElementById(id);
        const err = document.getElementById(errId);
        if (!el.value) { setError(el, err, msg); valid = false; }
        else clearError(el, err);
    });

    const surfEl  = document.getElementById(prefix+'-surface');
    const surfErr = document.getElementById(prefix+'-surface-err');
    const surfVal = surfEl.value.trim();
    if (!surfVal)                        { setError(surfEl, surfErr, '⚠️ La surface est obligatoire'); valid = false; }
    else if (isNaN(surfVal))             { setError(surfEl, surfErr, '⚠️ Entrez un nombre valide');   valid = false; }
    else if (parseFloat(surfVal) <= 0)   { setError(surfEl, surfErr, '⚠️ La surface doit être > 0');  valid = false; }
    else clearError(surfEl, surfErr);

    return valid;
}

document.addEventListener('DOMContentLoaded', function () {
    ['add','edit'].forEach(function(prefix) {
        [['type','change'],['nom','change'],['parcelle','change'],['date-plantation','change'],['surface','input']]
        .forEach(function([field, evt]) {
            const el  = document.getElementById(prefix+'-'+field);
            const err = document.getElementById(prefix+'-'+field+'-err');
            if (el && err) el.addEventListener(evt, () => clearError(el, err));
        });
    });
});

// ═══════════════════════════════════════
// MODAL HELPERS
// ═══════════════════════════════════════
function openModal(id) { 
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.style.display = 'flex'; 
    // Don't lock body overflow - let modal handle scrolling internally
}
function closeModal(id) {
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.style.display = 'none';
    document.querySelectorAll('#'+id+' .field-error').forEach(el => el.textContent = '');
    document.querySelectorAll('#'+id+' .form-control.is-invalid').forEach(el => el.classList.remove('is-invalid'));
}

{% if app.request.query.get('modal') == 'add' %}
    window.addEventListener('DOMContentLoaded', () => openModal('modal-add'));
{% endif %}

// ═══════════════════════════════════════
// CROP LIST
// ═══════════════════════════════════════
function updateCropList(prefix) {
    const type = document.getElementById(prefix+'-type').value;
    const nomSelect = document.getElementById(prefix+'-nom');
    nomSelect.innerHTML = '<option value="">— Sélectionner —</option>';
    if (type && CULTURE_MAP[type]) {
        CULTURE_MAP[type].forEach(crop => {
            const opt = document.createElement('option');
            opt.value = opt.textContent = crop;
            nomSelect.appendChild(opt);
        });
    }
}

// ═══════════════════════════════════════
// HARVEST DATE AUTO-CALCULATE
// ═══════════════════════════════════════
async function fetchHarvestDate(prefix) {
    const nom = document.getElementById(prefix+'-nom').value;
    const dp  = document.getElementById(prefix+'-date-plantation').value;
    const recolteInput = document.getElementById(prefix+'-date-recolte');
    const previewDiv   = document.getElementById(prefix+'-harvest-preview');
    if (!nom || !dp) return;
    try {
        const res  = await fetch(`{{ path('culture_harvest_date') }}?nom=${encodeURIComponent(nom)}&date=${dp}`);
        const data = await res.json();
        if (data.date) {
            recolteInput.value = data.date;
            previewDiv.innerHTML = `🗓️ Récolte estimée : <strong>${formatDate(data.date)}</strong>
                — Durée totale : <strong>${data.duration} jours</strong>
                (Semis: ${data.phases.semis}j · Croissance: ${data.phases.croissance}j · Maturité: ${data.phases.maturite}j)`;
            previewDiv.classList.add('visible');
        }
    } catch(e) { console.warn('Harvest date fetch failed', e); }
}

function formatDate(iso) { const [y,m,d] = iso.split('-'); return `${d}/${m}/${y}`; }

// ═══════════════════════════════════════
// EDIT MODAL
// ═══════════════════════════════════════
function openEditModal(id, nom, type, dp, dr, surface, parcelleId) {
    document.getElementById('form-edit').action = `/culture/${id}/edit`;
    const typeEl = document.getElementById('edit-type');
    typeEl.value = type;
    updateCropList('edit');
    setTimeout(() => {
        document.getElementById('edit-nom').value            = nom;
        document.getElementById('edit-date-plantation').value= dp || '';
        document.getElementById('edit-date-recolte').value   = dr || '';
        document.getElementById('edit-surface').value        = surface;
        document.getElementById('edit-parcelle').value       = parcelleId;
    }, 10);
    openModal('modal-edit');
}

{% if app.request.query.get('edit_id') %}
    window.addEventListener('DOMContentLoaded', () => {
        {% for culture in cultures %}
            {% if culture.id == app.request.query.get('edit_id') %}
            openEditModal(
                {{ culture.id }},
                '{{ culture.nom|e('js') }}',
                '{{ culture.typeCulture|e('js') }}',
                '{{ culture.datePlantation ? culture.datePlantation|date('Y-m-d') : '' }}',
                '{{ culture.dateRecolte ? culture.dateRecolte|date('Y-m-d') : '' }}',
                {{ culture.surface ?? 0 }},
                {{ culture.parcelle.id }}
            );
            {% endif %}
        {% endfor %}
    });
{% endif %}

// ═══════════════════════════════════════════════════════════════
// IA HARVEST MODAL
// ═══════════════════════════════════════════════════════════════

async function openHarvestModal(id, nom, surface, csrfToken) {
    // Reset modal state
    document.getElementById('harvest-loading').style.display = 'block';
    document.getElementById('harvest-result').style.display  = 'none';
    document.getElementById('harvest-error').style.display   = 'none';
    openModal('modal-harvest');

    try {
        const res  = await fetch(`/culture/${id}/ia-preview`);
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
        _fillHarvestModal(id, nom, csrfToken, data);
        document.getElementById('harvest-loading').style.display = 'none';
        document.getElementById('harvest-result').style.display  = 'block';
    } catch (err) {
        console.error('IA preview error:', err);
        document.getElementById('harvest-loading').style.display = 'none';
        document.getElementById('harvest-error').style.display   = 'block';
        document.getElementById('harvest-error-msg').textContent = 'Erreur IA : ' + err.message;
    }
}

function _fillHarvestModal(id, nom, csrfToken, data) {
    // Form wiring
    document.getElementById('harvest-confirm-form').action = `/culture/${id}/harvest`;
    document.getElementById('harvest-csrf-token').value    = csrfToken;
    document.getElementById('harvest-qty-input').value     = data.quantite;
    document.getElementById('harvest-score-input').value   = data.iaScore;
    document.getElementById('harvest-source-input').value  = data.source || 'php_fallback';

    // Header
    document.getElementById('harvest-culture-name').textContent = `🌾 ${nom}`;
    document.getElementById('harvest-confidence').textContent   =
        `Confiance : ${data.confidence}  ·  ${data.logsCount} jour(s) météo enregistré(s)`;
    document.getElementById('harvest-source-label').textContent =
        data.source === 'ml' ? '🤖 Modèle ML Python (Random Forest)' : '🧮 Formule agronomique PHP';

    // Score ring
    _drawScoreRing(data.iaScore);
    document.getElementById('score-label').innerHTML =
        `<span>${Math.round(data.iaScore)}%</span><span style="font-size:0.55rem;font-weight:500;">qualité</span>`;

    // KPI cards
    document.getElementById('ia-quantite').textContent = `${data.quantite} kg`;

    const lEl = document.getElementById('ia-lateness');
    lEl.textContent = `${data.latenessScore}%`;
    lEl.style.color = data.latenessScore < 80 ? '#dc2626' : data.latenessScore < 95 ? '#d97706' : '#16a34a';

    const wEl = document.getElementById('ia-weather');
    wEl.textContent = `${data.weatherScore}%`;
    wEl.style.color = data.weatherScore < 60 ? '#dc2626' : data.weatherScore < 80 ? '#d97706' : '#16a34a';

    // Breakdown
    const container = document.getElementById('breakdown-list');
    container.innerHTML = '';
    if (!data.breakdown || data.breakdown.length === 0) {
        container.innerHTML = `<div class="ia-bd-item success">
            <span class="ia-bd-icon">✅</span>
            <div><div class="ia-bd-label">Aucun facteur négatif détecté</div>
                 <div class="ia-bd-impact">Conditions idéales pendant toute la croissance</div></div></div>`;
    } else {
        data.breakdown.forEach(item => {
            const div = document.createElement('div');
            div.className = `ia-bd-item ${item.type || 'info'}`;
            div.innerHTML = `<span class="ia-bd-icon">${item.icon}</span>
                <div><div class="ia-bd-label">${item.label}</div>
                     <div class="ia-bd-impact">${item.impact}</div></div>`;
            container.appendChild(div);
        });
    }

    // Style confirm button by score
    const btn = document.getElementById('harvest-confirm-btn');
    if (data.iaScore < 50) {
        btn.style.background = '#dc2626';
        btn.textContent = '⚠️ Confirmer malgré les pertes';
    } else {
        btn.style.background = '#1e3c2c';
        btn.textContent = '✅ Confirmer la récolte';
    }
}

function _drawScoreRing(score) {
    const canvas = document.getElementById('score-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const cx  = 50, cy = 50, r = 42;
    const pct = Math.min(100, Math.max(0, score)) / 100;
    ctx.clearRect(0, 0, 100, 100);

    // Background track
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, 2*Math.PI);
    ctx.strokeStyle = '#e5e7eb'; ctx.lineWidth = 8; ctx.stroke();

    // Progress arc
    ctx.beginPath();
    ctx.arc(cx, cy, r, -Math.PI/2, -Math.PI/2 + pct*2*Math.PI);
    ctx.strokeStyle = pct > 0.75 ? '#16a34a' : pct > 0.5 ? '#d97706' : '#dc2626';
    ctx.lineWidth = 8; ctx.lineCap = 'round'; ctx.stroke();
}

function _submitHarvest() {
    const btn = document.getElementById('harvest-confirm-btn');
    btn.disabled = true;
    btn.textContent = '⏳ Enregistrement…';
    return true;
}

// ═══════════════════════════════════════════════════════════════
// DETAILS PANEL (double-click on card)
// ═══════════════════════════════════════════════════════════════
function openCultureDetail(id) {
    const c = CULTURES_DATA.find(x => x.id === id);
    if (!c) return;

    const existing = document.getElementById('culture-details-panel');
    const existingBd = document.getElementById('culture-details-backdrop');
    if (existing) {
        if (existing.dataset.cultureId == id) { existing.remove(); existingBd?.remove(); return; }
        existing.remove(); existingBd?.remove();
    }

    const fmtDate = iso => { if (!iso) return '—'; const [y,m,d] = iso.split('-'); return `${d}/${m}/${y}`; };
    const etatClass = etatToCssClass(c.etat);

    const panel = document.createElement('div');
    panel.id = 'culture-details-panel';
    panel.dataset.cultureId = id;
    panel.style.cssText = `
        position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
        background:white;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,0.3);
        padding:28px;z-index:9999;width:min(700px,90vw);max-height:85vh;overflow-y:auto;`;

    // IA harvest info block — shown if already harvested
    const iaBlock = c.quantiteRecolte !== null ? `
        <div style="margin-top:16px;padding:14px 16px;background:#f0fdf4;
                    border:1px solid #86efac;border-radius:10px;">
            <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;
                        color:#1e3c2c;margin-bottom:8px;letter-spacing:0.05em;">
                🤖 Résultat IA — Récolte confirmée
            </div>
            <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;">
                <div>
                    <div style="font-size:0.7rem;color:#6b7280;">Quantité récoltée</div>
                    <div style="font-size:1.5rem;font-weight:800;color:#1e3c2c;">${c.quantiteRecolte} kg</div>
                </div>
                ${c.iaScore !== null ? `<div>
                    <div style="font-size:0.7rem;color:#6b7280;">Score qualité IA</div>
                    <div style="font-size:1.5rem;font-weight:800;color:${
                        c.iaScore >= 75 ? '#16a34a' : c.iaScore >= 50 ? '#d97706' : '#dc2626'
                    };">${c.iaScore}%</div>
                </div>` : ''}
            </div>
        </div>` : '';

    panel.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
            <h2 style="margin:0;font-size:1.6rem;color:#1e3c2c;">${c.nom}</h2>
            <span class="etat-badge ${etatClass}">${c.etat}</span>
        </div>
        <div style="display:flex;gap:24px;flex-wrap:wrap;">
            <div style="width:180px;height:180px;border-radius:12px;overflow:hidden;background:var(--green-50);
                        flex-shrink:0;display:flex;align-items:center;justify-content:center;">
                <img src="/images/cultures/${c.img||'default.png'}" alt="${c.nom}"
                     style="width:100%;height:100%;object-fit:contain;"
                     onerror="this.parentElement.innerHTML='<span style=\\'font-size:3rem;\\'>🌱</span>'">
            </div>
            <div style="flex:1;display:grid;grid-template-columns:1fr 1fr;gap:12px;min-width:200px;">
                ${[
                    ['Type',c.typeCulture],
                    ['Surface',(c.surface||0)+' m²'],
                    ['Plantation',fmtDate(c.datePlantation)],
                    ['Récolte prévue',fmtDate(c.dateRecolte)],
                    ['Parcelle',c.parcelleName],
                ].map(([label,value]) => `
                    <div style="padding:12px;background:var(--green-50);border-radius:10px;border:1px solid var(--green-200);">
                        <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;color:var(--text-light);margin-bottom:4px;">${label}</div>
                        <div style="font-size:1rem;font-weight:600;color:var(--text-dark);">${value}</div>
                    </div>`).join('')}
            </div>
        </div>
        ${iaBlock}
        <div style="margin-top:20px;text-align:right;">
            <button class="btn btn-secondary btn-sm" id="close-details-btn">✕ Fermer</button>
        </div>`;

    const backdrop = document.createElement('div');
    backdrop.id = 'culture-details-backdrop';
    backdrop.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:9998;';
    backdrop.onclick = () => { panel.remove(); backdrop.remove(); };

    document.body.appendChild(backdrop);
    document.body.appendChild(panel);
    panel.querySelector('#close-details-btn').onclick = () => { panel.remove(); backdrop.remove(); };
}

function etatToCssClass(etat) {
    return {'Semis':'etat-semis','Croissance':'etat-croissance','Maturité':'etat-maturite',
            'Récolte Prévue':'etat-recolte-prevue','Récolte en Retard':'etat-recolte-en-retard'}[etat] || 'etat-semis';
}

function openAgendaModal() {
    const modal = document.getElementById('modal-agenda');
    const iframe = document.getElementById('agenda-iframe');
    if (!iframe.getAttribute('data-loaded')) {
        iframe.src = '{{ path('agenda_view') }}';
        iframe.setAttribute('data-loaded', '1');
    }
    modal.style.display = 'flex';
    // Don't lock body overflow - modal handles scrolling internally
}
function closeAgendaModal() {
    document.getElementById('modal-agenda').style.display = 'none';
    // Restore normal scrolling
}
</script>
        </div>
    </main>
</div>
