                                onclick="closeModal('modal-harvest')">Annuler</button>
                        <button type="submit" id="harvest-confirm-btn" class="btn btn-primary"
                                style="background:#1e3c2c;">
                            ✅ Confirmer la récolte
                        </button>
                    </div>
                </form>
            </div>

            {# Error state #}
            <div id="harvest-error" style="display:none;text-align:center;padding:20px;">
                <div style="font-size:2rem;margin-bottom:8px;">⚠️</div>
                <p id="harvest-error-msg" style="color:#dc2626;"></p>
                <button class="btn btn-secondary btn-sm" style="margin-top:12px;"
                        onclick="closeModal('modal-harvest')">Fermer</button>
            </div>

        </div>
    </div>
</div>

