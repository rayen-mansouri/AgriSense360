{% extends 'base.html.twig' %}
{% set activePage = 'cultures' %}
{% set activeSection = 'main' %}

{% block title %}Cultures — AgriSense 360{% endblock %}

{% block navbar %}{% endblock %}

{% block styles %}
{% include 'partials/sidebar_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('css/culture_premium.css') }}">
<style>
    /* Override page elements for dark theme */
    .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; flex-wrap: wrap; gap: 20px; }
    .page-title { font-size: 2.5rem; font-weight: 950; color: var(--ch3); margin-bottom: 4px; letter-spacing: -1px; }
    .page-subtitle { color: var(--cp); font-size: 1rem; font-weight: 600; }
    
    /* Toolbar refinement */
    .toolbar { 
        background: var(--cb); 
        padding: 20px; 
        border-radius: 24px; 
        margin-bottom: 40px; 
        border: 1px solid var(--cbr); 
        backdrop-filter: blur(10px);
        box-shadow: var(--sh-lg);
    }
    .search-input { 
        width: 100%; padding: 14px 18px 14px 44px; 
        border: 1px solid var(--cbr); border-radius: 16px; 
        background: rgba(0,0,0,0.1); color: var(--ch3); font-size: 0.95rem; 
        transition: all 0.3s;
    }
    .search-input:focus { border-color: var(--g); background: rgba(255,255,255,0.05); }
    
    /* Buttons */
    .btn { padding: 10px 20px; border-radius: 14px; font-weight: 700; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary { background: var(--g); border: none; box-shadow: 0 8px 20px rgba(90, 181, 90, 0.2); }
    
    /* Empty state */
    .empty-state { grid-column: 1 / -1; text-align: center; padding: 100px 20px; background: var(--cb); border-radius: 32px; border: 2px dashed var(--cbr); }
    .empty-icon { font-size: 5rem; margin-bottom: 24px; opacity: 0.5; }
    
    /* IA modal KPI cards */
    .ia-kpi { padding: 10px 12px; background: #f0fdf4; border: 1px solid #86efac; border-radius: 10px; text-align: center; }
    .ia-kpi-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; color: #6b7280; margin-bottom: 4px; }
    .ia-kpi-value { font-size: 1.05rem; font-weight: 800; color: #1e3c2c; }
    
    /* Breakdown items */
    .ia-bd-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 12px; border-radius: 8px; margin-bottom: 6px; font-size: 0.85rem; border-left: 3px solid transparent; }
    .ia-bd-item.danger  { background: #fff5f5; border-left-color: #dc2626; }
    .ia-bd-item.warning { background: #fffbeb; border-left-color: #d97706; }
    .ia-bd-item.info    { background: #eff6ff; border-left-color: #3b82f6; }
    .ia-bd-item.success { background: #f0fdf4; border-left-color: #16a34a; }
    .ia-bd-icon  { font-size: 1rem; flex-shrink: 0; margin-top: 1px; }
    .ia-bd-label { font-weight: 600; color: #1f2937; }
    .ia-bd-impact { font-size: 0.77rem; color: #6b7280; margin-top: 1px; }
    
    /* Add cursor pointer to indicate clickability */
    .culture-card-premium { cursor: pointer; }
</style>
{% endblock %}

{% block body %}
<div class="layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="main">
        <div style="padding: 30px;">

{# ═══════════════════════════════════════════════════
   PAGE HEADER
   ═══════════════════════════════════════════════════ #}
<div class="page-header">
    <div class="page-header-left">
        <p class="page-breadcrumb">
            <a href="{{ path('app_home') }}">🏠 Accueil</a> / Cultures
        </p>
        <h1 class="page-title">🌱 Cultures</h1>
        <p class="page-subtitle">{{ cultures|length }} culture(s) enregistrée(s)</p>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <a href="{{ path('parcelle_index') }}" class="btn btn-secondary">🗺️ Voir les parcelles</a>
        <a href="{{ path('culture_analytics') }}" class="btn btn-secondary">🤖 Analytique IA</a>
        <button class="btn btn-secondary" onclick="openAgendaModal()">📅 Agenda</button>
        <button class="btn-premium" onclick="openModal('modal-add')">➕ Nouvelle culture</button>
    </div>
</div>

{# ═══════════════════════════════════════════════════
   TOOLBAR
   ═══════════════════════════════════════════════════ #}
<div class="toolbar">
    <form method="get" action="{{ path('culture_index') }}" style="flex:1;display:flex;gap:10px;flex-wrap:wrap;">
        <div class="search-wrap" style="flex:1;min-width:200px;">
            <span class="search-icon">🔍</span>
            <input type="text"
                   name="search"
                   value="{{ search }}"
                   class="search-input"
                   placeholder="Rechercher une culture…"
                   autocomplete="off">
        </div>
        <div class="sort-group">
            <button type="submit" name="sort" value="type"
                    class="btn btn-secondary {% if sort == 'type' %}active{% endif %}">
                🏷️ Type
            </button>
            <button type="submit" name="sort" value="etat"
                    class="btn btn-secondary {% if sort == 'etat' %}active{% endif %}">
                📊 État
            </button>
            <button type="submit" name="sort" value="surface"
                    class="btn btn-secondary {% if sort == 'surface' %}active{% endif %}">
                📐 Surface
            </button>
            {% if sort or search %}
                <a href="{{ path('culture_index') }}" class="btn btn-secondary">↺ Reset</a>
            {% endif %}
        </div>
    </form>
</div>

{# ═══════════════════════════════════════════════════
   DONNÉES JS
   ═══════════════════════════════════════════════════ #}
<script>
const CULTURES_DATA = [
    {% for culture in cultures %}
    {
        id: {{ culture.id }},
        nom: {{ culture.nom|json_encode|raw }},
        typeCulture: {{ culture.typeCulture|json_encode|raw }},
        etat: {{ culture.etat|json_encode|raw }},
        surface: {{ culture.surface ?? 0 }},
        datePlantation: {{ culture.datePlantation ? culture.datePlantation|date('Y-m-d')|json_encode|raw : 'null' }},
        dateRecolte: {{ culture.dateRecolte ? culture.dateRecolte|date('Y-m-d')|json_encode|raw : 'null' }},
        img: {{ culture.img|json_encode|raw }},
        parcelleName: {{ (parcelleMap[culture.parcelle.id] ?? 'N/A')|json_encode|raw }},
        quantiteRecolte: {{ culture.quantiteRecolte is not null ? culture.quantiteRecolte : 'null' }},
        iaScore: {{ culture.iaScore is not null ? culture.iaScore : 'null' }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
];
</script>

{# ═══════════════════════════════════════════════════
   CULTURE CARDS GRID
   ═══════════════════════════════════════════════════ #}
<div class="card-grid">

    {% if cultures is empty %}
        <div class="empty-state">
            <div class="empty-icon">🌱</div>
            <div class="empty-title">Aucune culture trouvée</div>
            <div class="empty-subtitle">Ajoutez votre première culture pour commencer</div>
        </div>
    {% endif %}

    {% for culture in cultures %}
    <div class="culture-card-premium animate-fade-in" 
         style="animation-delay: {{ loop.index0 * 0.1 }}s;"
         title="Double-cliquez pour modifier"
         ondblclick="openEditModal({{ culture.id }},
                            '{{ culture.nom|e('js') }}',
                            '{{ culture.typeCulture|e('js') }}',
                            {{ culture.datePlantation ? "'" ~ culture.datePlantation|date('Y-m-d') ~ "'" : 'null' }},
                            {{ culture.dateRecolte ? "'" ~ culture.dateRecolte|date('Y-m-d') ~ "'" : 'null' }},
                            {{ culture.surface ?? 0 }},
                            {{ culture.parcelle.id }})">
        
        {# Harvest Ready Badge #}
        {% if culture.isReadyToHarvest() and culture.etat != 'Récolte' %}
            <div class="harvest-ready-badge">
                <span>🌾 Prêt à récolter</span>
            </div>
        {% endif %}

        <div class="card-img-container">
            {% if culture.img %}
                <img src="{{ asset('images/cultures/' ~ culture.img) }}" alt="{{ culture.nom }}">
            {% else %}
                <div style="width: 100%; height: 100%; background: var(--badge-g); display: flex; align-items: center; justify-content: center; font-size: 3.5rem;">🌱</div>
            {% endif %}
            
            <div class="status-badge" style="background: rgba(0,0,0,0.6); color: white;">
                {{ culture.typeCulture }}
            </div>

            {% if culture.etat == 'Récolte' and culture.quantiteRecolte is not null %}
                <div class="ia-harvested-badge" style="background: var(--harvest-gradient); bottom: 10px; left: 10px;">
                    ✨ {{ culture.quantiteRecolte|number_format(1) }} kg
                </div>
            {% endif %}
        </div>

        <div style="padding: 24px; flex: 1; display: flex; flex-direction: column;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 900; color: var(--ch3);">{{ culture.nom }}</h3>
                {% set eClass = culture.etat == 'Maturité' ? 'green' : (culture.etat == 'Croissance' ? 'blue' : 'orange') %}
                <span class="badge-{{ eClass }}" style="font-size: 0.7rem; padding: 4px 12px; border-radius: 50px; font-weight: 800;">{{ culture.etat|upper }}</span>
            </div>

            <div class="card-data-grid" style="padding: 0; margin-bottom: 20px;">
                <div class="data-item">
                    <span class="data-label">Surface</span>
                    <span class="data-value">{{ culture.surface }} <small>m²</small></span>
                </div>
                <div class="data-item">
                    <span class="data-label">Parcelle</span>
                    <span class="data-value">{{ parcelleMap[culture.parcelle.id] ?? 'N/A' }}</span>
                </div>
                <div class="data-item">
                    <span class="data-label">Plantation</span>
                    <span class="data-value">{{ culture.datePlantation ? culture.datePlantation|date('d/m/Y') : '—' }}</span>
                </div>
                <div class="data-item">
                    <span class="data-label">Récolte</span>
                    <span class="data-value">{{ culture.dateRecolte ? culture.dateRecolte|date('d/m/Y') : '—' }}</span>
                </div>
            </div>

            <div style="margin-top: auto; display: flex; gap: 8px; align-items: center;">
                {# Standard edit button #}
                {% if culture.etat != 'Récolte' %}
                <button class="btn btn-secondary btn-sm" style="flex: 1; padding: 8px;"
                        onclick="event.stopPropagation(); openEditModal({{ culture.id }},
                            '{{ culture.nom|e('js') }}',
                            '{{ culture.typeCulture|e('js') }}',
                            {{ culture.datePlantation ? "'" ~ culture.datePlantation|date('Y-m-d') ~ "'" : 'null' }},
                            {{ culture.dateRecolte ? "'" ~ culture.dateRecolte|date('Y-m-d') ~ "'" : 'null' }},
                            {{ culture.surface ?? 0 }},
                            {{ culture.parcelle.id }})">
                    ✏️ Edit
                </button>
                {% endif %}

                {# 🌾 RÉCOLTER button #}
                {% if culture.isReadyToHarvest() and culture.etat != 'Récolte' %}
                <button class="btn btn-save btn-sm" style="flex: 2; padding: 8px; background: var(--harvest-gradient); border: none;"
                        onclick="event.stopPropagation(); openHarvestModal(
                            {{ culture.id }},
                            {{ culture.nom|json_encode|raw }},
                            {{ culture.surface ?? 0 }},
                            {{ csrf_token('harvest-culture-' ~ culture.id)|json_encode|raw }}
                        )">
                    🌾 Récolter
                </button>
                {% endif %}

                {# Delete button #}
                <form method="post" action="{{ path('culture_delete', {id: culture.id}) }}"
                      onsubmit="return confirm('Supprimer « {{ culture.nom|e('js') }} » ?')"
                      onclick="event.stopPropagation();" style="margin:0;">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('del-culture-' ~ culture.id) }}">
                    <button type="submit" class="btn btn-danger btn-sm" style="padding: 8px;">🗑️</button>
                </form>
            </div>
        </div>
    </div>
    {% endfor %}

</div>

{# ═══════════════════════════════════════════════════
   MODAL — ADD CULTURE
   ═══════════════════════════════════════════════════ #}
<div id="modal-add" class="modal-backdrop" style="display:none;"
     onclick="if(event.target===this)closeModal('modal-add')">
    <div class="modal">
        <div class="modal-header">
            <span class="modal-title">+ Ajouter une Culture</span>
            <button class="modal-close" onclick="closeModal('modal-add')">×</button>
        </div>
        <form id="form-add" method="post" action="{{ path('culture_new') }}"
              onsubmit="return validateCultureForm('add')">
            <div class="modal-body">

                {% if app.request.query.has('error') %}
                <div style="background:#ffebee; border-left:4px solid #f44336; padding:12px; border-radius:5px; margin-bottom:15px; color:#c62828;">
                    ⚠️ Veuillez corriger les erreurs ci-dessous
                </div>
                {% endif %}

                <div class="form-group">
                    <label class="form-label">Type de culture <span class="required">*</span></label>
                    <select name="type_culture" id="add-type" class="form-control"
                            onchange="updateCropList('add')">
                        <option value="">— Sélectionner un type —</option>
                        {% for type, names in cultureMap %}
                            <option value="{{ type }}">{{ type }}</option>
                        {% endfor %}
                    </select>
                    <span class="field-error" id="add-type-err"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Culture <span class="required">*</span></label>
                    <select name="nom" id="add-nom" class="form-control"
                            onchange="fetchHarvestDate('add')">
                        <option value="">— Choisir d'abord le type —</option>
                    </select>
                    <span class="field-error" id="add-nom-err"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Parcelle <span class="required">*</span></label>
                    <select name="parcelle_id" id="add-parcelle" class="form-control">
                        <option value="">— Sélectionner une parcelle —</option>
                        {% for parcelle in parcelles %}
                            {% if parcelle.statut == 'Libre' and parcelle.surfaceRestant > 0.01 %}
                                <option value="{{ parcelle.id }}">
                                    {{ parcelle.nom }} — Restant: {{ parcelle.surfaceRestant|number_format(2,',') }} m²
                                </option>
                            {% endif %}
                        {% endfor %}
                    </select>
                    <span class="field-error" id="add-parcelle-err"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Date de plantation <span class="required">*</span></label>
                        <input type="date" name="date_plantation" id="add-date-plantation"
                               class="form-control"
                               onchange="fetchHarvestDate('add')">
                        <span class="field-error" id="add-date-plantation-err"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Surface (m²) <span class="required">*</span></label>
                        <input type="text" name="surface" id="add-surface" class="form-control"
                               placeholder="ex: 500">
                        <span class="field-error" id="add-surface-err"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Date de récolte <span style="font-size:0.75rem;color:#6b7280;font-weight:400;">(calculée automatiquement)</span></label>
                    <input type="date" name="date_recolte" id="add-date-recolte" class="form-control"
                           readonly tabindex="-1"
                           style="background:#f3f4f6;color:#6b7280;cursor:not-allowed;pointer-events:none;">
                    <div id="add-harvest-preview" class="harvest-preview">
                        🗓️ Date calculée automatiquement selon la durée de croissance
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('modal-add')">Annuler</button>
                <button type="submit" class="btn-premium">✓ Enregistrer</button>
            </div>
        </form>
    </div>
</div>

{# ═══════════════════════════════════════════════════
   MODAL — EDIT CULTURE
   ═══════════════════════════════════════════════════ #}
<div id="modal-edit" class="modal-backdrop" style="display:none;"
     onclick="if(event.target===this)closeModal('modal-edit')">
    <div class="modal">
        <div class="modal-header">
            <span class="modal-title">✏️ Modifier la Culture</span>
            <button class="modal-close" onclick="closeModal('modal-edit')">×</button>
        </div>
        <form id="form-edit" method="post" action=""
              onsubmit="return validateCultureForm('edit')">
            <div class="modal-body">

                {% if app.request.query.get('edit_error') == '1' %}
                <div style="background:#ffebee; border-left:4px solid #f44336; padding:12px; border-radius:5px; margin-bottom:15px; color:#c62828;">
                    ⚠️ Erreur lors de la modification. Veuillez vérifier les informations.
                </div>
                {% endif %}

                <div class="form-group">
                    <label class="form-label">Type de culture <span class="required">*</span></label>
                    <select name="type_culture" id="edit-type" class="form-control"
                            onchange="updateCropList('edit')">
                        <option value="">— Sélectionner un type —</option>
                        {% for type, names in cultureMap %}
                            <option value="{{ type }}">{{ type }}</option>
                        {% endfor %}
                    </select>
                    <span class="field-error" id="edit-type-err"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Culture <span class="required">*</span></label>
                    <select name="nom" id="edit-nom" class="form-control"
                            onchange="fetchHarvestDate('edit')">
                        <option value="">— Sélectionner —</option>
                    </select>
                    <span class="field-error" id="edit-nom-err"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Parcelle <span class="required">*</span></label>
                    <select name="parcelle_id" id="edit-parcelle" class="form-control">
                        <option value="">— Sélectionner une parcelle —</option>
                        {% for parcelle in parcelles %}
                            <option value="{{ parcelle.id }}" data-restant="{{ parcelle.surfaceRestant }}">
                                {{ parcelle.nom }} — Restant: {{ parcelle.surfaceRestant|number_format(2,',') }} m²
                            </option>
                        {% endfor %}
                    </select>
                    <span class="field-error" id="edit-parcelle-err"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Date de plantation <span class="required">*</span></label>
                        <input type="date" name="date_plantation" id="edit-date-plantation"
                               class="form-control"
                               onchange="fetchHarvestDate('edit')">
                        <span class="field-error" id="edit-date-plantation-err"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Surface (m²) <span class="required">*</span></label>
                        <input type="text" name="surface" id="edit-surface" class="form-control">
                        <span class="field-error" id="edit-surface-err"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Date de récolte <span style="font-size:0.75rem;color:#6b7280;font-weight:400;">(calculée automatiquement)</span></label>
                    <input type="date" name="date_recolte" id="edit-date-recolte" class="form-control"
                           readonly tabindex="-1"
                           style="background:#f3f4f6;color:#6b7280;cursor:not-allowed;pointer-events:none;">
                    <div id="edit-harvest-preview" class="harvest-preview">
                        🗓️ Date recalculée automatiquement selon la durée de croissance
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('modal-edit')">Annuler</button>
                <button type="submit" class="btn-premium">✓ Enregistrer</button>
            </div>
        </form>
    </div>
</div>

{# ═══════════════════════════════════════════════════
   MODAL — IA HARVEST (NEW)
   ═══════════════════════════════════════════════════ #}
<div id="modal-harvest" class="modal-backdrop" style="display:none;"
     onclick="if(event.target===this)closeModal('modal-harvest')">
    <div class="modal" style="max-width:540px;">
        <div class="modal-header" style="background:linear-gradient(135deg,#1e3c2c,#2a5a3a);">
            <span class="modal-title" style="color:#fff;">🌾 Récolte — Estimation IA</span>
            <button class="modal-close" style="color:#fff;" onclick="closeModal('modal-harvest')">×</button>
        </div>

        <div id="harvest-modal-body" style="padding:24px;">

            {# Loading #}
            <div id="harvest-loading" style="text-align:center;padding:40px 0;">
                <div style="font-size:2.5rem;margin-bottom:12px;">⏳</div>
                <p style="color:#6b7280;font-size:0.95rem;">Calcul IA en cours…</p>
            </div>

            {# Result (hidden until fetch completes) #}
            <div id="harvest-result" style="display:none;">

                {# Score ring + header #}
                <div style="display:flex;align-items:center;gap:20px;margin-bottom:20px;">
                    <div style="position:relative;width:100px;height:100px;flex-shrink:0;">
                        <canvas id="score-canvas" width="100" height="100"></canvas>
                        <div id="score-label" style="
                            position:absolute;inset:0;display:flex;flex-direction:column;
                            align-items:center;justify-content:center;
                            font-weight:800;font-size:1.15rem;color:#1e3c2c;line-height:1.1;"></div>
                    </div>
                    <div style="flex:1;">
                        <div id="harvest-culture-name" style="font-size:1.2rem;font-weight:700;color:#1e3c2c;margin-bottom:4px;"></div>
                        <div id="harvest-confidence" style="font-size:0.78rem;color:#6b7280;margin-bottom:2px;"></div>
                        <div id="harvest-source-label" style="font-size:0.72rem;color:#9ca3af;"></div>
                    </div>
                </div>

                {# KPI row #}
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:20px;">
                    <div class="ia-kpi">
                        <div class="ia-kpi-label">Quantité estimée</div>
                        <div class="ia-kpi-value" id="ia-quantite" style="color:#1e3c2c;"></div>
                    </div>
                    <div class="ia-kpi">
                        <div class="ia-kpi-label">Score latence</div>
                        <div class="ia-kpi-value" id="ia-lateness"></div>
                    </div>
                    <div class="ia-kpi">
                        <div class="ia-kpi-label">Score météo</div>
                        <div class="ia-kpi-value" id="ia-weather"></div>
                    </div>
                </div>

                {# Breakdown #}
                <div style="margin-bottom:20px;">
                    <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;
                                letter-spacing:0.06em;color:#6b7280;margin-bottom:8px;">
                        Facteurs détectés
                    </div>
                    <div id="breakdown-list"></div>
                </div>

                {# Confirm form #}
                <form method="post" id="harvest-confirm-form" onsubmit="return _submitHarvest()">
                    <input type="hidden" name="_token"           id="harvest-csrf-token">
                    <input type="hidden" name="quantite_recolte" id="harvest-qty-input">
                    <input type="hidden" name="ia_score"         id="harvest-score-input">
