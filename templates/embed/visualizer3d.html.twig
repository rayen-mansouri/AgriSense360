<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Wrapper — {{ parcelle.nom }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; height: 100%; overflow: hidden; background: #0f172a; }
        iframe { width: 100%; height: 100%; border: none; display: block; }
    </style>
</head>
<body>
    <iframe id="v3d-frame" src="{{ asset('visualizer3d/index.html') }}" onload="injectData()"></iframe>

    <script>
        // Data from Symfony
        var PARCELLE_DATA = {
            id: {{ parcelle.id }},
            nom: "{{ parcelle.nom|e('js') }}",
            surface: {{ parcelle.surface }},
            typeSol: "{{ parcelle.typeSol|e('js') }}",
            cultures: {{ cultureData|json_encode|raw }}
        };

        window.addEventListener('message', function(event) {
            if (event.data && event.data.type === '3D_READY') {
                console.log('3D Visualizer signaled READY');
                injectData();
            }
        });

        function injectData() {
            var frame = document.getElementById('v3d-frame');
            var maxRetries = 5;
            var retryCount = 0;

            function attemptInject() {
                try {
                    var win = frame.contentWindow;
                    if (win && typeof win.setParcelleData === 'function') {
                        win.setParcelleData(JSON.stringify(PARCELLE_DATA));
                        console.log('3D Data injected successfully');
                    } else if (retryCount < maxRetries) {
                        retryCount++;
                        setTimeout(attemptInject, 300);
                    }
                } catch(e) {
                    console.warn('3D Inject failed:', e);
                }
            }
            
            attemptInject();
        }
    </script>
</body>
</html>
