{% extends 'base.html.twig' %}
{% set activePage = 'dashboard' %}
{% set activeSection = 'main' %}
{% block title %}Tableau de bord — AgriSense 360{% endblock %}

{% block navbar %}{% endblock %}

{% block styles %}
{% include 'partials/home_nav_styles.html.twig' %}
{% include 'partials/sidebar_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('css/culture_premium.css') }}">
<style>
    .welcome-banner {
        background: linear-gradient(135deg, var(--s1), var(--s2));
        padding: 40px;
        border-radius: 32px;
        margin-bottom: 30px;
        border: 1px solid var(--cbr);
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: var(--sh-lg);
    }
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }
    .kpi-card-premium {
        background: var(--cb);
        backdrop-filter: blur(10px);
        border: 1px solid var(--cbr);
        padding: 24px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: all 0.3s;
    }
    .kpi-card-premium:hover {
        transform: translateY(-5px);
        border-color: var(--g);
    }
    .kpi-icon-wrap {
        width: 44px; height: 44px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="main">
        <div style="padding: 40px;">
            
            <div class="welcome-banner animate-fade-in">
                <div>
                    <h1 style="font-size: 2.2rem; font-weight: 950; color: var(--ch3); margin: 0; letter-spacing: -1px;">Bonjour, {{ user.name }} ✨</h1>
                    <p style="color: var(--cp); margin-top: 5px; font-weight: 600;">Voici l'aperçu global de votre exploitation aujourd'hui.</p>
                </div>
                <div style="display: flex; gap: 20px;">
                    <div style="text-align: right;">
                        <span style="display: block; font-size: 1.8rem; font-weight: 900; color: var(--g);">95%</span>
                        <span style="font-size: 0.7rem; font-weight: 800; color: var(--cp); text-transform: uppercase;">Matching IA</span>
                    </div>
                </div>
            </div>

            <div class="kpi-grid">
                <div class="kpi-card-premium animate-fade-in" style="animation-delay: 0.1s;">
                    <div class="kpi-icon-wrap" style="background: rgba(90, 181, 90, 0.1); color: var(--g);">🌱</div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 900; color: var(--ch3);">{{ culture_stats.total ?? 0 }}</div>
                        <div style="font-size: 0.75rem; color: var(--cp); font-weight: 700;">Cultures</div>
                    </div>
                </div>
                <div class="kpi-card-premium animate-fade-in" style="animation-delay: 0.2s;">
                    <div class="kpi-icon-wrap" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">👥</div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 900; color: var(--ch3);">{{ pending_count ?? 0 }}</div>
                        <div style="font-size: 0.75rem; color: var(--cp); font-weight: 700;">Postulants</div>
                    </div>
                </div>
                <div class="kpi-card-premium animate-fade-in" style="animation-delay: 0.3s;">
                    <div class="kpi-icon-wrap" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;">🚜</div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 900; color: var(--ch3);">{{ team_count ?? 0 }}</div>
                        <div style="font-size: 0.75rem; color: var(--cp); font-weight: 700;">Équipe</div>
                    </div>
                </div>
                <div class="kpi-card-premium animate-fade-in" style="animation-delay: 0.4s;">
                    <div class="kpi-icon-wrap" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">🌾</div>
                    <div>
                        <div style="font-size: 1.5rem; font-weight: 900; color: var(--ch3);">{{ culture_stats.pretes ?? 0 }}</div>
                        <div style="font-size: 0.75rem; color: var(--cp); font-weight: 700;">À récolter</div>
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;">
                <div class="left-col">
                    <h2 class="section-title">🕒 Candidatures récentes</h2>
                    {% if pending_applications is defined and pending_applications|length > 0 %}
                        <div style="display: flex; flex-direction: column; gap: 15px;">
                            {% for ouvrier in pending_applications|slice(0,4) %}
                                <div class="premium-stat-card animate-fade-in" style="padding: 20px; display: flex; align-items: center; gap: 20px; animation-delay: {{ 0.5 + loop.index0 * 0.1 }}s;">
                                    <div style="width: 50px; height: 50px; border-radius: 50%; background: var(--g); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; overflow: hidden;">
                                        {% if ouvrier.profilePicture %}
                                            <img src="{{ asset('uploads/profiles/' ~ ouvrier.profilePicture) }}" style="width: 100%; height: 100%; object-fit: cover;">
                                        {% else %}
                                            {{ ouvrier.name|first|upper }}
                                        {% endif %}
                                    </div>
                                    <div style="flex: 1;">
                                        <div style="font-weight: 800; color: var(--ch3);">{{ ouvrier.name }}</div>
                                        <div style="font-size: 0.8rem; color: var(--cp);">{{ ouvrier.email }}</div>
                                    </div>
                                    <div style="display: flex; gap: 10px;">
                                        <a href="{{ path('gerant_ouvrier_show', {id: ouvrier.id}) }}" class="btn" style="background: rgba(255,255,255,0.05); color: var(--ch3); border: 1px solid var(--cbr);">Profil</a>
                                        <button class="btn-premium" style="padding: 10px 20px; font-size: 0.85rem;">Accepter</button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div style="padding: 60px; background: var(--cb); border-radius: 24px; border: 2px dashed var(--cbr); text-align: center;">
                            <p style="color: var(--cp); margin: 0;">Aucune candidature en attente</p>
                        </div>
                    {% endif %}
                </div>

                <div class="right-col">
                    <h2 class="section-title">⚡ Actions</h2>
                    <div style="display: flex; flex-direction: column; gap: 15px;">
                        <a href="{{ path('culture_index') }}" class="btn-premium" style="justify-content: flex-start; gap: 15px; padding: 16px 24px;">
                            <span>🌿</span> Gérer les cultures
                        </a>
                        <a href="{{ path('parcelle_index') }}" class="btn-premium" style="justify-content: flex-start; gap: 15px; padding: 16px 24px; background: rgba(255,255,255,0.05); color: var(--ch3); border: 1px solid var(--cbr); box-shadow: none;">
                            <span>🗺️</span> Gérer les parcelles
                        </a>
                        <a href="{{ path('gerant_ouvriers') }}" class="btn-premium" style="justify-content: flex-start; gap: 15px; padding: 16px 24px; background: rgba(255,255,255,0.05); color: var(--ch3); border: 1px solid var(--cbr); box-shadow: none;">
                            <span>👥</span> Gérer l'équipe
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    const html = document.documentElement;
    const themeBtn = document.getElementById('themeToggleNav');
    if (themeBtn) {
        themeBtn.addEventListener('click', () => {
            const current = html.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('agri-theme', next);
        });
    }

    // Dropdown profile
    window.onclick = function(event) {
        if (!event.target.closest('.gerant-profile')) {
            const dropdown = document.getElementById('gerant-dropdown-nav');
            if (dropdown && dropdown.classList.contains('show')) {
                dropdown.classList.remove('show');
            }
        }
    }
</script>
{% endblock %}

