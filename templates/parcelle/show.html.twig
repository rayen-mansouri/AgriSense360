{% set activePage = 'parcelles' %}
{% set activeSection = 'main' %}

{% block title %}{{ parcelle.nom }} — Détails{% endblock %}

{% block navbar %}{% endblock %}

{% block styles %}
{% include 'partials/sidebar_styles.html.twig' %}
<style>
    /* Custom styles for this page to fix contrast and layout */
    .detail-card {
        background: var(--cb);
        border: 1px solid var(--cbr);
        border-radius: 24px;
        padding: 28px;
        margin-bottom: 32px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    .stat-box {
        background: var(--surface2);
        border: 1px solid var(--cbr);
        border-radius: 18px;
        padding: 20px;
        transition: transform 0.2s;
    }
    .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--cp);
        margin-bottom: 10px;
        letter-spacing: 0.5px;
    }
    .stat-value {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--ch3);
    }
    .section-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--ch3);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    /* Weather styles refined for themes */
    .weather-main-card { 
        border-radius: 20px; 
        padding: 0; 
        overflow: hidden; 
        box-shadow: 0 8px 32px rgba(0,0,0,.08); 
        margin-bottom: 24px; 
        border: 1px solid var(--cbr);
        background: var(--cb);
    }
    .weather-hero { 
        background: linear-gradient(135deg, var(--gd), var(--g)); 
        padding: 32px; 
        color: white; 
        position: relative; 
        overflow: hidden; 
    }
    .weather-stat-item { 
        padding: 16px 20px; 
        border-right: 1px solid var(--cbr); 
        text-align: center; 
    }
    .weather-stat-value { font-size: 1.1rem; font-weight: 800; color: var(--ch3); }

    /* Fix labels for dark mode */
    [data-theme="dark"] .stat-label, 
    [data-theme="dark"] .page-subtitle,
    [data-theme="dark"] .weather-stat-label {
        color: rgba(255,255,255,0.7) !important;
    }

    /* 3D Visualizer Modal */
    .v3d-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.9);
        backdrop-filter: blur(8px);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }
    .v3d-container {
        width: 100%;
        height: 100%;
        background: #0f172a;
        border-radius: 32px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 40px 100px rgba(0,0,0,0.5);
        position: relative;
    }
    .v3d-close {
        position: absolute;
        top: 20px;
        right: 20px;
        width: 44px;
        height: 44px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 2010;
        transition: all 0.2s;
        font-size: 1.2rem;
    }
    .v3d-close:hover {
        background: #ef4444;
        transform: scale(1.1);
    }
</style>
{% endblock %}

{% block body %}
<div class="layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="main">
        <div style="padding: 30px;">

            {# PAGE HEADER #}
            <div class="page-header" style="margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
                <div class="page-header-left">
                    <p class="page-breadcrumb" style="font-size: 0.85rem; color: var(--cp); margin-bottom: 8px;">
                        <a href="{{ path('app_home') }}" style="color: inherit; text-decoration: none;">🏠 Accueil</a> /
                        <a href="{{ path('parcelle_index') }}" style="color: inherit; text-decoration: none;">Parcelles</a> /
                        <span style="color: var(--ch3);">{{ parcelle.nom }}</span>
                    </p>
                    <h1 class="page-title" style="font-size: 2rem; font-weight: 900; color: var(--ch3); margin: 0;">🗺️ {{ parcelle.nom }}</h1>
                    <p class="page-subtitle" style="color: var(--cp); margin-top: 5px;">{{ cultures|length }} culture(s) active(s)</p>
                </div>
                <div style="display:flex; gap:12px; align-items:center;">
                    <button type="button" class="btn btn-save" style="background: linear-gradient(135deg, #10b981, #059669); border:none;" onclick="openVisualizer()">🎮 Visualiser 3D</button>
                    <a href="{{ path('parcelle_index') }}" class="btn btn-pale">← Retour</a>
                    <a href="{{ path('culture_index') }}" class="btn btn-save">🌱 Gérer les cultures</a>
                </div>
            </div>

            {# FLASH MESSAGES #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-{{ type == 'success' ? 'success' : 'error' }}" style="margin: 0 0 20px 0;">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div style="display: grid; grid-template-columns: 1fr 350px; gap: 30px; align-items: start;">
                
                {# LEFT COLUMN: MAIN CONTENT #}
                <div class="left-col">
                    
                    {# PARCELLE INFO CARD #}
                    <div class="detail-card">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:28px;">
                            <h2 style="margin:0; font-size:1.4rem; font-weight:800; color:var(--ch3); display: flex; align-items: center; gap: 12px;">
                                <span style="background: var(--badge-g); padding: 10px; border-radius: 12px;">📋</span>
                                Détails de la parcelle
                            </h2>
                            <span class="badge-{{ parcelle.statut == 'Libre' ? 'green' : 'orange' }}" style="padding: 6px 16px; font-size: 0.85rem;">
                                {{ parcelle.statut == 'Libre' ? '🟢 Libre' : '🟠 Occupée' }}
                            </span>
                        </div>

                        <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:16px; margin-bottom:24px;">
                            <div class="stat-box">
                                <div class="stat-label">📐 Surface totale</div>
                                <div class="stat-value">{{ parcelle.surface|number_format(0,',',' ') }} <small style="font-size: 0.7em; opacity: 0.6;">m²</small></div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-label">📏 Disponible</div>
                                <div class="stat-value" style="color: {{ parcelle.surfaceRestant <= 0.01 ? 'var(--danger)' : 'var(--g)' }};">
                                    {{ parcelle.surfaceRestant|number_format(1,',',' ') }} <small style="font-size: 0.7em; opacity: 0.6;">m²</small>
                                </div>
                            </div>
                        </div>

                        {# Progress bar #}
                        {% set taux = parcelle.tauxOccupation %}
                        <div style="background: var(--surface2); border: 1px solid var(--cbr); border-radius:16px; padding:20px;">
                            <div style="display:flex; justify-content:space-between; align-items: center; margin-bottom:12px;">
                                <span style="font-size:0.85rem; font-weight:700; color:var(--ch3);">📊 Taux d'occupation</span>
                                <span style="font-size: 1.1rem; font-weight:900; color:{{ taux >= 90 ? 'var(--danger)' : (taux >= 60 ? '#f59e0b' : 'var(--g)') }};">{{ taux }}%</span>
                            </div>
                            <div style="height: 10px; background: rgba(0,0,0,0.1); border-radius: 50px; overflow: hidden; border: 1px solid var(--cbr);">
                                <div style="height: 100%; width: {{ taux }}%; background: linear-gradient(90deg, var(--g), var(--gm)); border-radius: 50px; transition: width 1s;"></div>
                            </div>
                        </div>
                    </div>

                    {# CULTURES LIST #}
                    <h2 class="section-title">🌱 Cultures sur cette parcelle</h2>
                    
                    {% if cultures is empty %}
                        <div style="text-align:center; padding:60px 20px; background:var(--cb); border:1.5px dashed var(--cbr); border-radius:24px;">
                            <div style="font-size:3rem; margin-bottom:15px;">🌾</div>
                            <h3 style="color:var(--ch3); margin-bottom:8px;">Aucune culture active</h3>
                            <p style="color:var(--cp); font-size:0.9rem; margin-bottom:20px;">Cette parcelle est actuellement libre de toute culture.</p>
                            <a href="{{ path('culture_index') }}" class="btn btn-save">Ajouter une culture</a>
                        </div>
                    {% else %}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px;">
                            {% for culture in cultures %}
                                <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column;">
                                    <div style="height: 140px; position: relative; overflow: hidden;">
                                        {% if culture.img %}
                                            <img src="{{ asset('images/cultures/' ~ culture.img) }}" alt="{{ culture.nom }}" style="width: 100%; height: 100%; object-fit: cover;">
                                        {% else %}
                                            <div style="width: 100%; height: 100%; background: var(--badge-g); display: flex; align-items: center; justify-content: center; font-size: 3rem;">🌱</div>
                                        {% endif %}
                                        <div style="position: absolute; top: 12px; left: 12px;">
                                            <span class="badge-green" style="background: rgba(0,0,0,0.5); color: #fff; backdrop-filter: blur(4px); border: none;">{{ culture.typeCulture }}</span>
                                        </div>
                                    </div>
                                    <div style="padding: 20px; flex: 1;">
                                        <h3 style="margin: 0 0 8px 0; font-size: 1.1rem; font-weight: 800; color: var(--ch3);">{{ culture.nom }}</h3>
                                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px;">
                                            {% set eClass = culture.etat == 'Maturité' ? 'green' : (culture.etat == 'Croissance' ? 'blue' : 'orange') %}
                                            <span class="badge-{{ eClass }}" style="font-size: 0.7rem;">{{ culture.etat }}</span>
                                            <span style="font-size: 0.8rem; color: var(--cp);">• {{ culture.surface }} m²</span>
                                        </div>
                                        
                                        <div style="font-size: 0.8rem; color: var(--cp); line-height: 1.6;">
                                            <div style="display: flex; justify-content: space-between;">
                                                <span>📅 Plantation:</span>
                                                <span style="color: var(--ch3); font-weight: 600;">{{ culture.datePlantation ? culture.datePlantation|date('d/m/Y') : '—' }}</span>
                                            </div>
                                            <div style="display: flex; justify-content: space-between;">
                                                <span>🌾 Récolte:</span>
                                                <span style="color: var(--ch3); font-weight: 600;">{{ culture.dateRecolte ? culture.dateRecolte|date('d/m/Y') : '—' }}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div style="padding: 15px 20px; border-top: 1px solid var(--cbr); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.02);">
                                        <a href="{{ path('culture_details', {id: culture.id}) }}" class="btn btn-pale" style="padding: 6px 12px; font-size: 0.8rem;">Détails</a>
                                        {% if culture.etat in ['Maturité', 'Récolte Prévue', 'Récolte en Retard'] %}
                                            <button type="button" class="btn btn-save" style="padding: 6px 12px; font-size: 0.8rem;" onclick="handleRecolteQuick('{{ culture.id }}', '{{ culture.nom|e('js') }}', '{{ path('culture_harvest_rapport', {id: culture.id}) }}')">🌾 Récolter</button>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                </div>

                {# RIGHT COLUMN: SIDEBAR CONTENT #}
                <div class="right-col">
                    
                    {# WEATHER CARD #}
                    <h2 class="section-title" style="font-size: 1rem;">🌤️ Météo locale</h2>
                    {% if weather %}
                        <div class="weather-main-card" style="margin-bottom: 20px;">
                            <div class="weather-hero" style="padding: 24px;">
                                <div style="font-size: 0.8rem; opacity: 0.8; margin-bottom: 10px;">📍 {{ weather.location }}</div>
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="font-size: 3rem; font-weight: 900;">{{ weather.temp }}°</div>
                                    <div style="font-size: 2.5rem;">{{ weather.emoji }}</div>
                                </div>
                                <div style="font-size: 0.9rem; font-weight: 700; margin-top: 5px;">{{ weather.description }}</div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--cbr);">
                                <div style="padding: 15px; text-align: center; border-right: 1px solid var(--cbr);">
                                    <div style="font-size: 0.65rem; color: var(--cp); text-transform: uppercase;">Humidité</div>
                                    <div style="font-size: 1rem; font-weight: 800; color: var(--ch3);">{{ weather.humidity }}%</div>
                                </div>
                                <div style="padding: 15px; text-align: center;">
                                    <div style="font-size: 0.65rem; color: var(--cp); text-transform: uppercase;">Vent</div>
                                    <div style="font-size: 1rem; font-weight: 800; color: var(--ch3);">{{ weather.wind_speed }} <small>km/h</small></div>
                                </div>
                            </div>
                        </div>
                        
                        {# Agri Advice #}
                        <div class="detail-card" style="padding: 20px; border-radius: 20px;">
                            <div style="font-size: 0.85rem; font-weight: 800; color: var(--ch3); margin-bottom: 15px; display: flex; align-items: center; gap: 8px;">
                                🌾 Conseils du jour
                            </div>
                            {% for tip in weather.agri_advice|slice(0,3) %}
                                <div style="display: flex; gap: 10px; margin-bottom: 12px; font-size: 0.8rem; line-height: 1.4; color: var(--cp);">
                                    <span style="flex-shrink: 0;">{{ tip.icon }}</span>
                                    <span style="color: var(--ch3);">{{ tip.text }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div style="padding: 24px; background: var(--cb); border: 1px dashed var(--cbr); border-radius: 20px; text-align: center; color: var(--cp); font-size: 0.85rem;">
                            Météo indisponible
                        </div>
                    {% endif %}

                    {# QUICK LINKS / STATS #}
                    <div class="detail-card" style="margin-top: 20px; padding: 20px; border-radius: 20px;">
                        <h3 style="font-size: 0.9rem; margin: 0 0 15px 0; color: var(--ch3);">🌍 Localisation</h3>
                        <div class="stat-box" style="padding: 15px;">
                            <div class="stat-label" style="font-size: 0.65rem;">Gouvernorat</div>
                            <div class="stat-value" style="font-size: 1.1rem;">{{ parcelle.localisation }}</div>
                        </div>
                        <div class="stat-box" style="padding: 15px; margin-top: 10px;">
                            <div class="stat-label" style="font-size: 0.65rem;">Type de sol</div>
                            <div class="stat-value" style="font-size: 1.1rem;">{{ parcelle.typeSol }}</div>
                        </div>
                        
                        <a href="{{ path('parcelle_historique', {id: parcelle.id}) }}" class="btn btn-pale" style="width: 100%; margin-top: 20px; justify-content: center;">📜 Voir l'historique</a>
                    </div>

                </div>
            </div>

        </div>

        {# RAPPORT MODAL #}
        <div id="rapportModal" class="rapport-overlay" style="display:none;">
            <div class="rapport-box">
                <div class="rapport-header">
                    <div class="rapport-header-left">
                        <span class="rapport-big-icon">🌾</span>
                        <div>
                            <div class="rapport-title">Analyse IA Récolte</div>
                            <div class="rapport-culture-name" id="rapportCultureName"></div>
                        </div>
                    </div>
                    <div class="rapport-score-badge" id="rapportScoreBadge">
                        <div class="rapport-score-value" id="rapportScore">—</div>
                        <div class="rapport-score-label">Score</div>
                    </div>
                </div>
                <div class="rapport-qty-row">
                    <div class="rapport-qty-block">
                        <div class="rapport-qty-label">Estimation</div>
                        <div class="rapport-qty-value" id="rapportQty">—</div>
                    </div>
                </div>
                <div class="rapport-text" id="rapportText">Chargement…</div>
                <div class="rapport-footer">
                    <button class="btn-rapport-cancel" onclick="cancelRecolte()">Annuler</button>
                    <button class="btn-rapport-ok" id="btnConfirmRecolte" onclick="confirmRecolte()">✅ Confirmer</button>
                </div>
            </div>
        </div>

    </main>
</div>

{# 3D VISUALIZER MODAL #}
<div id="v3dModal" class="v3d-overlay">
    <div class="v3d-container">
        <button class="v3d-close" onclick="closeVisualizer()">✕</button>
        <iframe id="v3dFrame" style="width:100%; height:100%; border:none;"></iframe>
    </div>
</div>

<script>
var _pendingForm = null;
function handleRecolteQuick(id, nom, url) {
    // Create a dummy form for submission
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/culture/' + id + '/harvest';
    var token = document.createElement('input');
    token.type = 'hidden';
    token.name = '_token';
    token.value = '{{ csrf_token("harvest-culture-") }}' + id; // This is a bit tricky with dynamic IDs
    form.appendChild(token);
    document.body.appendChild(form);
    
    _pendingForm = form;

    document.getElementById('rapportCultureName').textContent = nom;
    document.getElementById('rapportModal').style.display = 'flex';
    document.getElementById('rapportText').textContent = 'Analyse de la parcelle en cours...';
    
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
            document.getElementById('rapportScore').textContent = d.iaScore + '%';
            document.getElementById('rapportQty').textContent = parseFloat(d.quantite).toFixed(2) + ' kg';
            document.getElementById('rapportText').textContent = d.rapport;
        })
        .catch(() => {
            document.getElementById('rapportText').textContent = 'Erreur lors de l\'analyse IA.';
        });
}

function confirmRecolte() {
    if (_pendingForm) _pendingForm.submit();
}
function cancelRecolte() {
    document.getElementById('rapportModal').style.display = 'none';
}

// 3D Visualizer Logic
function openVisualizer() {
    const modal = document.getElementById('v3dModal');
    const frame = document.getElementById('v3dFrame');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    
    // Load the visualizer route
    frame.src = "{{ path('parcelle_visualizer', {id: parcelle.id}) }}";
}

function closeVisualizer() {
    const modal = document.getElementById('v3dModal');
    const frame = document.getElementById('v3dFrame');
    modal.style.display = 'none';
    document.body.style.overflow = 'auto';
    frame.src = "about:blank"; // Stop the 3D engine
}
</script>
{% endblock %}
