{% set activePage = 'parcelles' %}
{% set activeSection = 'main' %}

{% block title %}{{ parcelle.nom }} — Détails{% endblock %}

{% block navbar %}{% endblock %}

{% block styles %}
{% include 'partials/sidebar_styles.html.twig' %}
<link rel="stylesheet" href="{{ asset('css/culture_premium.css') }}">
<style>
    /* Custom styles for this page to fix contrast and layout */
    .detail-card {
        background: var(--cb);
        border: 1px solid var(--cbr);
        border-radius: 28px;
        padding: 32px;
        margin-bottom: 32px;
        box-shadow: var(--sh-lg);
        backdrop-filter: blur(10px);
    }
    .stat-box {
        background: var(--surface2);
        border: 1px solid var(--cbr);
        border-radius: 20px;
        padding: 24px;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .stat-box:hover {
        transform: translateY(-5px);
        border-color: var(--g);
    }
    .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--cp);
        margin-bottom: 12px;
        letter-spacing: 1px;
    }
    .stat-value {
        font-size: 1.6rem;
        font-weight: 900;
        color: var(--ch3);
    }
    .section-title {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--ch3);
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    /* Weather styles refined */
    .weather-main-card { 
        border-radius: 24px; 
        padding: 0; 
        overflow: hidden; 
        box-shadow: var(--sh-lg); 
        margin-bottom: 24px; 
        border: 1px solid var(--cbr);
        background: var(--cb);
    }
    .weather-hero { 
        background: linear-gradient(135deg, var(--gd), var(--g)); 
        padding: 32px; 
        color: white; 
        position: relative; 
        overflow: hidden; 
    }
    
    /* Animations */
    .fade-in-up {
        animation: fadeInUp 0.6s ease-out forwards;
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Modal Styling */
    .modal-backdrop {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(15px);
        z-index: 2000;
        display: none;
        align-items: center; justify-content: center;
        padding: 20px;
    }
    .modal-content {
        background: var(--sidebar-bg);
        border: 1px solid var(--sidebar-border);
        border-radius: 32px;
        width: 100%; max-width: 550px;
        max-height: 90vh; overflow-y: auto;
        position: relative;
        box-shadow: 0 50px 100px rgba(0,0,0,0.5);
    }
</style>
{% endblock %}

{% block body %}
<div class="layout">
    {% include 'partials/sidebar.html.twig' %}

    <main class="main">
        <div style="padding: 40px;">

            {# PAGE HEADER #}
            <div class="page-header fade-in-up" style="margin-bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
                <div class="page-header-left">
                    <p class="page-breadcrumb" style="font-size: 0.85rem; color: var(--cp); margin-bottom: 12px;">
                        <a href="{{ path('app_home') }}" style="color: inherit; text-decoration: none;">🏠 Accueil</a> /
                        <a href="{{ path('parcelle_index') }}" style="color: inherit; text-decoration: none;">Parcelles</a> /
                        <span style="color: var(--ch3); font-weight: 700;">{{ parcelle.nom }}</span>
                    </p>
                    <h1 class="page-title" style="font-size: 2.5rem; font-weight: 950; color: var(--ch3); margin: 0; letter-spacing: -1px;">🗺️ {{ parcelle.nom }}</h1>
                    <p class="page-subtitle" style="color: var(--cp); margin-top: 8px; font-weight: 600;">{{ cultures|length }} culture(s) active(s) sur cette parcelle</p>
                </div>
                <div style="display:flex; gap:12px; align-items:center;">
                    <button type="button" class="btn" style="background: rgba(255,255,255,0.05); color: var(--ch3); border: 1px solid var(--cbr); padding: 12px 24px;" onclick="openVisualizer()">🎮 Vue 3D</button>
                    <button type="button" class="btn btn-save" style="padding: 12px 28px; font-weight: 800; box-shadow: 0 10px 20px rgba(90, 181, 90, 0.2);" onclick="openAddCultureModal()">🌱 Ajouter Culture</button>
                    <a href="{{ path('parcelle_index') }}" class="btn btn-pale" style="padding: 12px 20px;">← Retour</a>
                </div>
            </div>

            {# FLASH MESSAGES #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-{{ type == 'success' ? 'success' : 'error' }}" style="margin-bottom: 30px; border-radius: 20px; font-weight: 600;">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            <div style="display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: start;">
                
                {# LEFT COLUMN: MAIN CONTENT #}
                <div class="left-col">
                    
                    {# PARCELLE INFO CARD #}
                    <div class="detail-card fade-in-up" style="animation-delay: 0.1s;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:32px;">
                            <h2 style="margin:0; font-size:1.5rem; font-weight:900; color:var(--ch3); display: flex; align-items: center; gap: 14px;">
                                <span style="background: var(--badge-g); width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center;">📋</span>
                                Fiche Technique
                            </h2>
                            <span class="badge-{{ parcelle.statut == 'Libre' ? 'green' : 'orange' }}" style="padding: 8px 20px; font-size: 0.85rem; font-weight: 800; border-radius: 50px; text-transform: uppercase;">
                                {{ parcelle.statut == 'Libre' ? '🟢 Disponible' : '🟠 En Exploitation' }}
                            </span>
                        </div>

                        <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:20px; margin-bottom:32px;">
                            <div class="stat-box">
                                <div class="stat-label">📐 Surface Totale</div>
                                <div class="stat-value">{{ parcelle.surface|number_format(0,',',' ') }} <small style="font-size: 0.6em; opacity: 0.5; font-weight: 600;">m²</small></div>
                            </div>
                            <div class="stat-box">
                                <div class="stat-label">📏 Espace Disponible</div>
                                <div class="stat-value" style="color: {{ parcelle.surfaceRestant <= 0.01 ? 'var(--danger)' : 'var(--g)' }};">
                                    {{ parcelle.surfaceRestant|number_format(1,',',' ') }} <small style="font-size: 0.6em; opacity: 0.5; font-weight: 600;">m²</small>
                                </div>
                            </div>
                        </div>

                        {# Progress bar #}
                        {% set taux = parcelle.tauxOccupation %}
                        <div style="background: rgba(0,0,0,0.05); border: 1px solid var(--cbr); border-radius:24px; padding:24px;">
                            <div style="display:flex; justify-content:space-between; align-items: center; margin-bottom:16px;">
                                <span style="font-size:0.9rem; font-weight:800; color:var(--ch3); text-transform: uppercase; letter-spacing: 0.5px;">📊 Taux d'Occupation</span>
                                <span style="font-size: 1.4rem; font-weight:950; color:{{ taux >= 90 ? 'var(--danger)' : (taux >= 60 ? '#f59e0b' : 'var(--g)') }};">{{ taux }}%</span>
                            </div>
                            <div style="height: 12px; background: rgba(0,0,0,0.1); border-radius: 50px; overflow: hidden; border: 1px solid var(--cbr);">
                                <div style="height: 100%; width: {{ taux }}%; background: linear-gradient(90deg, var(--g), var(--gm)); border-radius: 50px; transition: width 1.5s cubic-bezier(0.19, 1, 0.22, 1); box-shadow: 0 0 15px rgba(90, 181, 90, 0.3);"></div>
                            </div>
                        </div>
                    </div>

                    {# CULTURES LIST #}
                    <h2 class="section-title fade-in-up" style="animation-delay: 0.2s;">
                        <span style="background: var(--g); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">🌱 Cultures actives</span>
                    </h2>
                    
                    {% if cultures is empty %}
                        <div class="fade-in-up" style="animation-delay: 0.3s; text-align:center; padding:80px 40px; background:var(--cb); border:2px dashed var(--cbr); border-radius:32px;">
                            <div style="font-size:4rem; margin-bottom:20px; filter: grayscale(1);">🌾</div>
                            <h3 style="color:var(--ch3); margin-bottom:12px; font-weight: 800;">Aucune culture sur cette parcelle</h3>
                            <p style="color:var(--cp); font-size:1rem; margin-bottom:30px; max-width: 400px; margin-left: auto; margin-right: auto;">Optimisez votre rendement en ajoutant une nouvelle culture dès maintenant.</p>
                            <button onclick="openAddCultureModal()" class="btn btn-save" style="padding: 14px 32px;">+ Ajouter une culture</button>
                        </div>
                    {% else %}
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; margin-bottom: 40px;">
                            {% for culture in cultures %}
                                <div class="culture-card-premium fade-in-up" style="animation-delay: {{ 0.2 + (loop.index * 0.1) }}s;">
                                    
                                    {# Harvest Badge #}
                                    {% if culture.isReadyToHarvest() %}
                                        <div class="harvest-ready-badge">
                                            <span>🌾 Prêt à récolter</span>
                                        </div>
                                    {% endif %}

                                    <div class="card-img-container">
                                        {% if culture.img %}
                                            <img src="{{ asset('images/cultures/' ~ culture.img) }}" alt="{{ culture.nom }}">
                                        {% else %}
                                            <div style="width: 100%; height: 100%; background: var(--badge-g); display: flex; align-items: center; justify-content: center; font-size: 3.5rem;">🌱</div>
                                        {% endif %}
                                        <div class="status-badge" style="background: rgba(0,0,0,0.6); color: white;">
                                            {{ culture.typeCulture }}
                                        </div>
                                    </div>

                                    <div style="padding: 24px; flex: 1;">
                                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                                            <h3 style="margin: 0; font-size: 1.3rem; font-weight: 900; color: var(--ch3);">{{ culture.nom }}</h3>
                                            {% set eClass = culture.etat == 'Maturité' ? 'green' : (culture.etat == 'Croissance' ? 'blue' : 'orange') %}
                                            <span class="badge-{{ eClass }}" style="font-size: 0.7rem; padding: 4px 12px; border-radius: 50px; font-weight: 800;">{{ culture.etat|upper }}</span>
                                        </div>

                                        <div class="card-data-grid" style="padding: 0; margin-bottom: 20px;">
                                            <div class="data-item">
                                                <span class="data-label">Plantation</span>
                                                <span class="data-value">{{ culture.datePlantation ? culture.datePlantation|date('d M Y') : '—' }}</span>
                                            </div>
                                            <div class="data-item">
                                                <span class="data-label">Récolte Prévue</span>
                                                <span class="data-value" style="color: {{ culture.isReadyToHarvest() ? '#f59e0b' : 'inherit' }};">
                                                    {{ culture.dateRecolte ? culture.dateRecolte|date('d M Y') : '—' }}
                                                </span>
                                            </div>
                                            <div class="data-item">
                                                <span class="data-label">Surface Occupée</span>
                                                <span class="data-value">{{ culture.surface }} <small>m²</small></span>
                                            </div>
                                            <div class="data-item">
                                                <span class="data-label">Santé Culture</span>
                                                <span class="data-value" style="color: var(--g);">Excellente ✨</span>
                                            </div>
                                        </div>

                                        <div style="display: flex; gap: 10px; margin-top: auto;">
                                            <a href="{{ path('culture_details', {id: culture.id}) }}" class="btn" style="flex: 1; background: rgba(255,255,255,0.05); color: var(--ch3); border: 1px solid var(--cbr); font-size: 0.8rem; padding: 10px;">Explorer</a>
                                            {% if culture.isReadyToHarvest() %}
                                                <button type="button" class="btn btn-save" style="flex: 2; font-size: 0.8rem; background: var(--harvest-gradient); border: none;" onclick="handleRecolteQuick('{{ culture.id }}', '{{ culture.nom|e('js') }}', '{{ path('culture_ia_preview', {id: culture.id}) }}')">🌾 Récolter</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                </div>

                {# RIGHT COLUMN: SIDEBAR CONTENT #}
                <div class="right-col">
                    
                    {# WEATHER CARD #}
                    <h2 class="section-title fade-in-up" style="font-size: 1.1rem; animation-delay: 0.4s;">🌤️ Météo Locale</h2>
                    {% if weather %}
                        <div class="weather-main-card fade-in-up" style="animation-delay: 0.5s;">
                            <div class="weather-hero">
                                <div style="font-size: 0.8rem; font-weight: 700; opacity: 0.8; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 1px;">📍 {{ weather.location }}</div>
                                <div style="display: flex; align-items: center; justify-content: space-between;">
                                    <div style="font-size: 3.5rem; font-weight: 950; letter-spacing: -2px;">{{ weather.temp }}°</div>
                                    <div style="font-size: 3rem; filter: drop-shadow(0 0 10px rgba(255,255,255,0.5));">{{ weather.emoji }}</div>
                                </div>
                                <div style="font-size: 1.1rem; font-weight: 800; margin-top: 10px;">{{ weather.description }}</div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--cbr); background: var(--cb);">
                                <div style="padding: 20px; text-align: center; border-right: 1px solid var(--cbr);">
                                    <div style="font-size: 0.7rem; color: var(--cp); text-transform: uppercase; font-weight: 800; margin-bottom: 5px;">Humidité</div>
                                    <div style="font-size: 1.2rem; font-weight: 900; color: var(--ch3);">{{ weather.humidity }}%</div>
                                </div>
                                <div style="padding: 20px; text-align: center;">
                                    <div style="font-size: 0.7rem; color: var(--cp); text-transform: uppercase; font-weight: 800; margin-bottom: 5px;">Vent</div>
                                    <div style="font-size: 1.2rem; font-weight: 900; color: var(--ch3);">{{ weather.wind_speed }} <small style="font-size: 0.7rem;">km/h</small></div>
                                </div>
                            </div>
                        </div>
                        
                        {# Agri Advice #}
                        <div class="detail-card fade-in-up" style="animation-delay: 0.6s; padding: 24px; border-radius: 24px;">
                            <div style="font-size: 1rem; font-weight: 900; color: var(--ch3); margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                                <span style="background: var(--badge-g); width: 32px; height: 32px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">✨</span>
                                Conseils AgriSense
                            </div>
                            {% for tip in weather.agri_advice|slice(0,3) %}
                                <div style="display: flex; gap: 14px; margin-bottom: 16px; font-size: 0.9rem; line-height: 1.5; color: var(--cp); background: rgba(0,0,0,0.02); padding: 12px; border-radius: 14px; border: 1px solid var(--cbr);">
                                    <span style="font-size: 1.2rem;">{{ tip.icon }}</span>
                                    <span style="color: var(--ch3); font-weight: 500;">{{ tip.text }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div style="padding: 30px; background: var(--cb); border: 2px dashed var(--cbr); border-radius: 24px; text-align: center; color: var(--cp); font-size: 0.9rem;">
                            ⚠️ Données météo indisponibles
                        </div>
                    {% endif %}

                    {# QUICK LINKS / STATS #}
                    <div class="detail-card fade-in-up" style="animation-delay: 0.7s; margin-top: 24px; padding: 24px;">
                        <h3 style="font-size: 1rem; font-weight: 900; margin: 0 0 20px 0; color: var(--ch3);">📊 Informations Terrain</h3>
                        <div class="stat-box" style="padding: 18px; margin-bottom: 12px;">
                            <div class="stat-label" style="font-size: 0.65rem;">Gouvernorat</div>
                            <div class="stat-value" style="font-size: 1.2rem;">{{ parcelle.localisation }}</div>
                        </div>
                        <div class="stat-box" style="padding: 18px;">
                            <div class="stat-label" style="font-size: 0.65rem;">Type de sol</div>
                            <div class="stat-value" style="font-size: 1.2rem;">{{ parcelle.typeSol }}</div>
                        </div>
                        
                        <a href="{{ path('parcelle_historique', {id: parcelle.id}) }}" class="btn" style="width: 100%; margin-top: 24px; background: var(--surface2); color: var(--ch3); border: 1px solid var(--cbr); padding: 14px; font-weight: 700;">📜 Historique d'exploitation</a>
                    </div>

                </div>
            </div>

        </div>

        {# RAPPORT MODAL (PREMIUM STYLE) #}
        <div id="rapportModal" class="modal-backdrop">
            <div class="modal-content glass-modal animate-fade-in" style="max-width: 500px;">
                <div style="padding: 32px;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 24px;">
                        <div style="width: 60px; height: 60px; border-radius: 20px; background: var(--harvest-gradient); display: flex; align-items: center; justify-content: center; font-size: 1.8rem;">🌾</div>
                        <div>
                            <h2 style="margin: 0; font-size: 1.4rem; font-weight: 900; color: white;">Récolte IA</h2>
                            <p id="rapportCultureName" style="margin: 5px 0 0; color: rgba(255,255,255,0.6); font-weight: 600;"></p>
                        </div>
                    </div>

                    <div style="display: flex; gap: 15px; margin-bottom: 24px;">
                        <div style="flex: 1; background: rgba(255,255,255,0.05); padding: 20px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); text-align: center;">
                            <div style="font-size: 0.7rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 8px;">Estimation Qty</div>
                            <div id="rapportQty" style="font-size: 1.5rem; font-weight: 900; color: #f59e0b;">—</div>
                        </div>
                        <div style="flex: 1; background: rgba(255,255,255,0.05); padding: 20px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); text-align: center;">
                            <div style="font-size: 0.7rem; color: rgba(255,255,255,0.5); text-transform: uppercase; font-weight: 800; margin-bottom: 8px;">Score Qualité</div>
                            <div id="rapportScore" style="font-size: 1.5rem; font-weight: 900; color: var(--g);">—</div>
                        </div>
                    </div>

                    <div id="rapportText" style="padding: 20px; background: rgba(0,0,0,0.2); border-radius: 20px; color: rgba(255,255,255,0.8); font-size: 0.95rem; line-height: 1.6; margin-bottom: 30px; min-height: 80px;">
                        Chargement de l'analyse IA...
                    </div>

                    <div style="display: flex; gap: 12px;">
                        <button class="btn btn-pale" style="flex: 1; padding: 14px; color: white;" onclick="cancelRecolte()">Annuler</button>
                        <button class="btn btn-save" id="btnConfirmRecolte" style="flex: 2; padding: 14px; background: var(--harvest-gradient); border: none;" onclick="confirmRecolte()">✅ Confirmer la récolte</button>
                    </div>
                </div>
            </div>
        </div>

        {# ADD CULTURE MODAL #}
        <div id="addCultureModal" class="modal-backdrop">
            <div class="modal-content glass-modal animate-fade-in" style="max-width: 600px;">
                <div style="padding: 32px;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 30px;">
                        <div style="width: 50px; height: 50px; border-radius: 16px; background: var(--g); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🌱</div>
                        <h2 style="margin: 0; font-size: 1.6rem; font-weight: 950; color: white; letter-spacing: -1px;">Nouvelle Culture</h2>
                    </div>

                    <form action="{{ path('culture_new') }}" method="POST">
                        {# PRE-FILLED PARCELLE #}
                        <input type="hidden" name="parcelle_id" value="{{ parcelle.id }}">
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                            <div class="form-group">
                                <label style="display: block; color: rgba(255,255,255,0.6); font-size: 0.8rem; font-weight: 700; margin-bottom: 8px;">TYPE DE CULTURE</label>
                                <select name="type_culture" class="form-control" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); color: white;" required onchange="updateCropOptions(this.value)">
                                    <option value="">Sélectionner</option>
                                    <option value="Céréales">🌾 Céréales</option>
                                    <option value="Légumes">🥕 Légumes</option>
                                    <option value="Fruits">🍎 Fruits</option>
                                    <option value="Ornementales">🌸 Ornementales</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label style="display: block; color: rgba(255,255,255,0.6); font-size: 0.8rem; font-weight: 700; margin-bottom: 8px;">NOM DE LA CULTURE</label>
                                <select name="nom" id="culture_name_select" class="form-control" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); color: white;" required>
                                    <option value="">Choisir un type</option>
                                </select>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                            <div class="form-group">
                                <label style="display: block; color: rgba(255,255,255,0.6); font-size: 0.8rem; font-weight: 700; margin-bottom: 8px;">DATE DE PLANTATION</label>
                                <input type="date" name="date_plantation" class="form-control" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); color: white;" value="{{ "now"|date("Y-m-d") }}" required>
                            </div>
                            <div class="form-group">
                                <label style="display: block; color: rgba(255,255,255,0.6); font-size: 0.8rem; font-weight: 700; margin-bottom: 8px;">SURFACE (m²)</label>
                                <input type="number" name="surface" step="0.1" max="{{ parcelle.surfaceRestant }}" placeholder="Max: {{ parcelle.surfaceRestant }}" class="form-control" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); color: white;" required>
                            </div>
                        </div>

                        <div style="background: rgba(90, 181, 90, 0.05); padding: 15px; border-radius: 16px; border: 1px solid rgba(90, 181, 90, 0.2); color: var(--g); font-size: 0.85rem; margin-bottom: 30px; display: flex; gap: 10px; align-items: center;">
                            <span>💡</span>
                            <span>La date de récolte et les phases de croissance seront calculées automatiquement par notre IA.</span>
                        </div>

                        <div style="display: flex; gap: 12px; justify-content: flex-end;">
                            <button type="button" class="btn btn-pale" style="padding: 12px 24px; color: white;" onclick="closeAddCultureModal()">Annuler</button>
                            <button type="submit" class="btn btn-save" style="padding: 12px 32px; font-weight: 800;">✓ Créer la culture</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </main>
</div>

{# 3D VISUALIZER MODAL #}
<div id="v3dModal" class="modal-backdrop">
    <div style="width: 95vw; height: 90vh; background: #000; border-radius: 32px; overflow: hidden; position: relative; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 50px 100px rgba(0,0,0,0.8);">
        <button onclick="closeVisualizer()" style="position: absolute; top: 25px; right: 25px; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.1); color: white; cursor: pointer; z-index: 100; font-size: 1.2rem; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(10px);">✕</button>
        <iframe id="v3dFrame" style="width: 100%; height: 100%; border: none;"></iframe>
    </div>
</div>

<script>
var _pendingForm = null;
var _harvestData = null;

function handleRecolteQuick(id, nom, url) {
    _pendingForm = document.createElement('form');
    _pendingForm.method = 'POST';
    _pendingForm.action = '/culture/' + id + '/harvest';
    
    var token = document.createElement('input');
    token.type = 'hidden';
    token.name = '_token';
    token.value = '{{ csrf_token("harvest-culture-") }}' + id;
    _pendingForm.appendChild(token);
    
    var qtyInput = document.createElement('input');
    qtyInput.type = 'hidden';
    qtyInput.name = 'quantite_recolte';
    qtyInput.id = 'hidden_qty';
    _pendingForm.appendChild(qtyInput);

    var scoreInput = document.createElement('input');
    scoreInput.type = 'hidden';
    scoreInput.name = 'ia_score';
    scoreInput.id = 'hidden_score';
    _pendingForm.appendChild(scoreInput);

    document.body.appendChild(_pendingForm);

    document.getElementById('rapportCultureName').textContent = nom;
    document.getElementById('rapportModal').style.display = 'flex';
    document.getElementById('rapportText').textContent = 'Analyse des données en cours...';
    
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(d => {
            _harvestData = d;
            document.getElementById('rapportScore').textContent = d.iaScore + '%';
            document.getElementById('rapportQty').textContent = parseFloat(d.quantite).toFixed(2) + ' kg';
            document.getElementById('rapportText').innerHTML = d.rapport || 'Analyse IA terminée avec succès.';
            
            document.getElementById('hidden_qty').value = d.quantite;
            document.getElementById('hidden_score').value = d.iaScore;
        })
        .catch(() => {
            document.getElementById('rapportText').textContent = 'Erreur lors de l\'analyse IA.';
        });
}

function confirmRecolte() {
    if (_pendingForm) _pendingForm.submit();
}
function cancelRecolte() {
    document.getElementById('rapportModal').style.display = 'none';
    if(_pendingForm) _pendingForm.remove();
}

function openAddCultureModal() {
    document.getElementById('addCultureModal').style.display = 'flex';
}
function closeAddCultureModal() {
    document.getElementById('addCultureModal').style.display = 'none';
}

const CROP_MAP = {
    'Céréales': ['Blé','Maïs','Riz','Avoine'],
    'Légumes': ['Tomates','Salades','Pomme de terre','Carottes','Oignon','Lentille'],
    'Fruits': ['Pomme','Pêche','Orange','Fraise','Framboise','Banane'],
    'Ornementales': ['Rosier','Tulipe','Jasmin','Laurier-rose']
};

function updateCropOptions(type) {
    const select = document.getElementById('culture_name_select');
    select.innerHTML = '<option value="">Sélectionner</option>';
    if (CROP_MAP[type]) {
        CROP_MAP[type].forEach(c => {
            const opt = document.createElement('option');
            opt.value = c;
            opt.textContent = c;
            select.appendChild(opt);
        });
    }
}

function openVisualizer() {
    document.getElementById('v3dModal').style.display = 'flex';
    document.getElementById('v3dFrame').src = "{{ path('parcelle_visualizer', {id: parcelle.id}) }}";
}
function closeVisualizer() {
    document.getElementById('v3dModal').style.display = 'none';
    document.getElementById('v3dFrame').src = "";
}

// Close modals on backdrop click
window.onclick = function(event) {
    if (event.target.className === 'modal-backdrop') {
        event.target.style.display = 'none';
    }
}
</script>
{% endblock %}
